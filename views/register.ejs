<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registo - LegoTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8f9fa; display: flex; align-items: center; justify-content: center; height: 100vh; }
        .login-card { width: 100%; max-width: 400px; padding: 2rem; border-radius: 15px; background: white; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
    </style>
</head>
<body>
    <div class="login-card">
        <h4 class="fw-bold mb-4 text-center">Criar Conta 🧱</h4>
        <form action="/register" method="POST">
            <div class="mb-2">
                <label class="small fw-bold">Nome Completo</label>
                <input type="text" name="name" class="form-control rounded-pill" required>
            </div>
            <div class="mb-2">
                <label class="small fw-bold">Email</label>
                <input type="email" name="email" class="form-control rounded-pill" required>
            </div>
            <div class="mb-3">
                <label class="small fw-bold">Palavra-passe</label>
                <input type="password" name="password" class="form-control rounded-pill" required>
            </div>
            <button type="submit" class="btn btn-success w-100 rounded-pill py-2">Criar Conta</button>
        </form>
        <div class="mt-3 text-center small">
            Já tens conta? <a href="/login">Faz Login</a>
        </div>
    </div>
</body>
</html>
