<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= user.dark_mode ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= set.name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>
<nav class="navbar border-bottom mb-4 bg-body">
    <div class="container-fluid"><a class="navbar-brand fw-bold" href="/">🧱 LegoTracker</a><a href="/" class="btn btn-outline-secondary btn-sm">Voltar</a></div>
</nav>

<div class="container pb-5">
    <div class="row g-4">
        <div class="col-lg-6 text-center">
            <img src="<%= set.img_url %>" class="img-fluid rounded shadow-sm bg-white p-3" style="max-height: 450px;">
        </div>
        <div class="col-lg-6">
            <h1 class="fw-bold"><%= set.name %></h1>
            <p class="text-muted">Set #<%= set.set_num %> · <%= set.year %> · <%= set.theme_name %></p>
            
            <div class="row g-2 mb-4 text-center">
                <div class="col"><div class="p-3 border rounded"><strong>Peças:</strong><br><%= set.num_parts %></div></div>
                <div class="col"><div class="p-3 border rounded text-success"><strong>Valor RRP:</strong><br><%= set.price_eur %>€</div></div>
            </div>

            <% if (user) { %>
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex gap-2 mb-3">
                        <button onclick="updateStatus('OWNED')" class="btn flex-fill <%= set.user_status==='OWNED'?'btn-success':'btn-outline-success' %>">Tenho</button>
                        <button onclick="updateStatus('WANTED')" class="btn flex-fill <%= set.user_status==='WANTED'?'btn-danger':'btn-outline-danger' %>">Quero</button>
                    </div>
                    <% if (set.user_status === 'OWNED') { %>
                        <form id="detailsForm" class="row g-2 small">
                            <div class="col-6"><label class="fw-bold">Estado</label><select class="form-select form-select-sm" id="build_status"><option value="Montado" <%=set.build_status==='Montado'?'selected':''%>>Montado</option><option value="Desmontado" <%=set.build_status==='Desmontado'?'selected':''%>>Desmontado</option></select></div>
                            <div class="col-6"><label class="fw-bold">Local</label><input type="text" class="form-control form-control-sm" id="location" value="<%= set.location %>"></div>
                            <div class="col-12"><button type="button" onclick="saveDetails()" class="btn btn-primary btn-sm w-100 mt-2">Guardar</button></div>
                        </form>
                    <% } %>
                </div>
            </div>
            <% } %>
            <a href="<%= set.rb_url %>" target="_blank" class="btn btn-outline-primary w-100">Ver no Rebrickable</a>
        </div>
    </div>
</div>
<script>
    async function updateStatus(s) { await fetch('/api/toggle', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ set_num: '<%= set.set_num %>', status: s })}); window.location.reload(); }
    async function saveDetails() {
        const body = { set_num: '<%= set.set_num %>', build_status: document.getElementById('build_status').value, location: document.getElementById('location').value, purchase_price: 0 };
        await fetch('/api/user_set/update', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body)});
        alert("Guardado!");
    }
</script>
</body>
</html>
