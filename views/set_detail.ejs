<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= user && user.dark_mode ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <title><%= set.name %> - LegoTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>

<nav class="navbar navbar-expand-lg border-bottom mb-4 bg-body">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="/">🧱 LegoTracker</a>
        <a href="/" class="btn btn-outline-secondary btn-sm">Voltar</a>
    </div>
</nav>

<div class="container py-4">
    <div class="row">
        <div class="col-md-5 mb-4 text-center">
            <img src="<%= set.img_url %>" class="img-fluid rounded shadow-sm" style="max-height: 500px;">
        </div>

        <div class="col-md-7">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-primary">#<%= set.set_num %></span>
                <span class="badge bg-secondary"><%= set.year %></span>
                <span class="badge bg-info text-dark"><%= set.theme_name %></span>
            </div>
            
            <h1 class="fw-bold mb-3"><%= set.name %></h1>
            
            <div class="row mb-4">
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Peças</div>
                    <div class="fs-5 fw-bold"><%= set.num_parts %></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">PVP (Estimado)</div>
                    <div class="fs-5 fw-bold text-success"><%= set.price_eur ? set.price_eur + '€' : 'N/A' %></div>
                </div>
            </div>

            <% if (user) { %>
                <div class="card bg-body-tertiary border-0 p-3 mb-3">
                    <h6 class="fw-bold mb-3"><i class="bi bi-collection"></i> A Minha Coleção</h6>
                    
                    <div class="d-flex gap-2 mb-4">
                        <button onclick="toggleStatus('OWNED')" class="btn <%= set.user_status === 'OWNED' ? 'btn-success' : 'btn-outline-success' %> flex-fill">
                            <i class="bi bi-check-lg"></i> Tenho
                        </button>
                        <button onclick="toggleStatus('WANTED')" class="btn <%= set.user_status === 'WANTED' ? 'btn-danger' : 'btn-outline-danger' %> flex-fill">
                            <i class="bi bi-heart"></i> Quero
                        </button>
                    </div>

                    <% if (set.user_status === 'OWNED') { %>
                        <form id="editForm">
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="small fw-bold">Localização</label>
                                    <input type="text" class="form-control form-control-sm" id="loc" value="<%= set.location || '' %>" placeholder="Ex: Prateleira A">
                                </div>
                                <div class="col-md-6">
                                    <label class="small fw-bold">Estado</label>
                                    <select class="form-select form-select-sm" id="build">
                                        <option value="Montado" <%= set.build_status === 'Montado' ? 'selected' : '' %>>Montado</option>
                                        <option value="Desmontado" <%= set.build_status === 'Desmontado' ? 'selected' : '' %>>Desmontado</option>
                                        <option value="Selado" <%= set.build_status === 'Selado' ? 'selected' : '' %>>Novo (Selado)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="small fw-bold">Preço de Compra (€)</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" id="price" value="<%= set.purchase_price || 0 %>">
                                </div>
                                <div class="col-md-6">
                                    <label class="small fw-bold text-success">PVP Oficial (€)</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm border-success" id="rrp" value="<%= set.price_eur || 0 %>">
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm w-100" onclick="saveDetails()">Guardar Detalhes</button>
                        </form>
                    <% } %>
                </div>
            <% } %>

            <a href="<%= set.rb_url %>" target="_blank" class="btn btn-link text-decoration-none ps-0">
                <i class="bi bi-box-arrow-up-right"></i> Ver no Rebrickable
            </a>
        </div>
    </div>
</div>

<script>
    const setNum = "<%= set.set_num %>";

    async function toggleStatus(status) {
        let newStatus = status;
        if ("<%= set.user_status %>" === status) newStatus = 'REMOVE';
        
        await fetch('/api/toggle', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ set_num: setNum, status: newStatus })
        });
        window.location.reload();
    }

    async function saveDetails() {
        const body = {
            set_num: setNum,
            build_status: document.getElementById('build').value,
            location: document.getElementById('loc').value,
            purchase_price: document.getElementById('price').value,
            price_eur: document.getElementById('rrp').value
        };

        const res = await fetch('/api/user_set/update', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(body)
        });

        if (res.ok) alert('Guardado!');
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
