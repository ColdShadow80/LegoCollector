<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= user && user.dark_mode ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - LegoTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .stats-card { transition: transform 0.2s; }
        .stats-card:hover { transform: translateY(-5px); }
    </style>
</head>
<body class="bg-body-tertiary">

<nav class="navbar navbar-expand-lg border-bottom mb-4 bg-body">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="/">🧱 LegoTracker</a>
        <div class="d-flex gap-3">
            <a href="/" class="btn btn-outline-secondary btn-sm">Minha Coleção</a>
            <span class="navbar-text small">Bem-vindo, <%= user.name %></span>
        </div>
    </div>
</nav>

<div class="container pb-5">
    <h3 class="mb-4 fw-bold"><i class="bi bi-speedometer2"></i> Dashboard da Coleção</h3>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 stats-card border-start border-4 border-primary">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Dimensão</h6>
                    <h3 class="fw-bold text-primary mb-0"><%= stats.total_sets %> Sets</h3>
                    <small class="text-muted"><%= stats.total_parts ? stats.total_parts.toLocaleString('pt-PT') : 0 %> peças</small>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card shadow-sm border-0 stats-card border-start border-4 border-warning">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Investimento (Gasto)</h6>
                    <h3 class="fw-bold text-warning">€ <%= stats.total_spent ? stats.total_spent.toLocaleString('pt-PT', {minimumFractionDigits: 2}) : '0,00' %></h3>
                    <small class="text-muted">Valor pago real</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 stats-card border-start border-4 border-success">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Valor de Mercado (PVP)</h6>
                    <h3 class="fw-bold text-success">€ <%= stats.total_value_rrp ? stats.total_value_rrp.toLocaleString('pt-PT', {minimumFractionDigits: 2}) : '0,00' %></h3>
                    <% 
                       let diff = (stats.total_value_rrp || 0) - (stats.total_spent || 0);
                       let color = diff >= 0 ? 'text-success' : 'text-danger';
                       let signal = diff >= 0 ? '+' : '';
                    %>
                    <small class="<%= color %> fw-bold"><%= signal %>€ <%= diff.toLocaleString('pt-PT', {minimumFractionDigits: 2}) %></small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 stats-card border-start border-4 border-danger">
                <div class="card-body">
                    <h6 class="text-muted small text-uppercase fw-bold">Lista de Desejos</h6>
                    <h3 class="fw-bold text-danger"><%= wishlist.wanted_count %> Sets</h3>
                    <small class="text-muted">PVP Est. € <%= wishlist.wanted_value ? wishlist.wanted_value.toLocaleString('pt-PT') : '0' %></small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent fw-bold">Top 5 Temas</div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <div style="width: 300px; height: 300px;">
                        <canvas id="chartThemes"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent fw-bold">Sets por Ano</div>
                <div class="card-body">
                    <canvas id="chartYears"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const themesData = <%- JSON.stringify(themes) %>;
    const yearsData = <%- JSON.stringify(years) %>;

    if(themesData.length > 0) {
        new Chart(document.getElementById('chartThemes'), {
            type: 'doughnut',
            data: {
                labels: themesData.map(t => t.name),
                datasets: [{
                    data: themesData.map(t => t.count),
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6c757d'],
                    borderWidth: 1
                }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });
    }

    if(yearsData.length > 0) {
        new Chart(document.getElementById('chartYears'), {
            type: 'bar',
            data: {
                labels: yearsData.map(y => y.year),
                datasets: [{
                    label: 'Quantidade',
                    data: yearsData.map(y => y.count),
                    backgroundColor: '#0dcaf0',
                    borderRadius: 4
                }]
            },
            options: { scales: { y: { beginAtZero: true } }, plugins: { legend: { display: false } } }
        });
    }
</script>
</body>
</html>
