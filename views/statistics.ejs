<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= user && user.dark_mode ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <title>Estatísticas da Coleção</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<nav class="navbar navbar-expand-lg border-bottom mb-4 bg-body">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="/">🧱 LegoTracker</a>
        <a href="/account" class="btn btn-outline-secondary btn-sm">Minha Conta</a>
    </div>
</nav>
<div class="container py-4">
    <h2 class="mb-4 fw-bold">📊 Estatísticas da Coleção</h2>
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white fw-bold">Geral</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Sets: <span class="fw-bold text-primary"><%= stats.total_sets %></span></li>
                        <li class="list-group-item">Peças: <span class="fw-bold text-warning"><%= stats.total_parts %></span></li>
                        <li class="list-group-item">Valor total: <span class="fw-bold text-success"><%= stats.total_value %>€</span></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white fw-bold">Sets Owned</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Sets: <span class="fw-bold text-success"><%= stats.owned_count %></span></li>
                        <li class="list-group-item">Peças: <span class="fw-bold text-success"><%= stats.owned_parts %></span></li>
                        <li class="list-group-item">Valor: <span class="fw-bold text-success"><%= stats.owned_value %>€</span></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-danger text-white fw-bold">Sets Wanted</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Sets: <span class="fw-bold text-danger"><%= stats.wanted_count %></span></li>
                        <li class="list-group-item">Peças: <span class="fw-bold text-danger"><%= stats.wanted_parts %></span></li>
                        <li class="list-group-item">Valor: <span class="fw-bold text-danger"><%= stats.wanted_value %>€</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body fw-bold">Top 5 Temas</div>
                <div class="card-body">
                    <canvas id="themesChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body fw-bold">Sets por Ano</div>
                <div class="card-body">
                    <canvas id="yearsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    window.themesData = <%- JSON.stringify(themes) %>;
    window.yearsData = <%- JSON.stringify(years) %>;
    new Chart(document.getElementById('themesChart'), {
        type: 'doughnut',
        data: {
            labels: themesData.map(t => t.name),
            datasets: [{
                data: themesData.map(t => t.count),
                backgroundColor: ['#0d6efd', '#6610f2', '#6f42c1', '#d63384', '#dc3545']
            }]
        }
    });
    new Chart(document.getElementById('yearsChart'), {
        type: 'bar',
        data: {
            labels: yearsData.map(y => y.year),
            datasets: [{
                label: 'Sets',
                data: yearsData.map(y => y.count),
                backgroundColor: '#198754'
            }]
        },
        options: { scales: { y: { beginAtZero: true } } }
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
