<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrar - LegoTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .card-login { max-width: 400px; width: 100%; border: none; shadow: 0 10px 30px rgba(0,0,0,0.1); }
    </style>
</head>
<body>

<div class="card card-login rounded-4 p-4">
    <div class="text-center mb-4">
        <h3 class="fw-bold">LegoTracker</h3>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger small"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success small"><%= success %></div>
    <% } %>

    <ul class="nav nav-pills nav-fill mb-4" id="pills-tab" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pills-login">Login</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pills-register">Registar</button></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="pills-login">
            <form action="/login" method="POST">
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" required>
                    <div class="text-end mt-1">
                        <a href="/forgot" class="text-decoration-none small text-muted">Esqueci a password</a>
                    </div>
                </div>
                <button type="submit" class="btn btn-dark w-100 py-2">Entrar</button>
            </form>
            <div class="text-center my-3 text-muted">- OU -</div>
            <a href="/auth/google" class="btn btn-outline-danger w-100">Entrar com Google</a>
        </div>

        <div class="tab-pane fade" id="pills-register">
            <form action="/register" method="POST">
                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <input type="text" name="name" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-success w-100 py-2">Criar Conta</button>
            </form>
            <div class="mt-3 text-center small text-muted">
                Será enviado um email de confirmação.
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
