<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - LegoTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8f9fa; display: flex; align-items: center; justify-content: center; height: 100vh; }
        .login-card { width: 100%; max-width: 400px; padding: 2rem; border-radius: 15px; background: white; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <h4 class="fw-bold mb-4">🧱 LegoTracker</h4>
        
        <a href="/auth/google" class="btn btn-outline-dark w-100 mb-3 rounded-pill">
            <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" width="18" class="me-2"> Entrar com Google
        </a>

        <div class="text-muted small mb-3">- ou -</div>

        <form action="/login" method="POST">
            <input type="email" name="email" class="form-control mb-2 rounded-pill" placeholder="Email" required>
            <input type="password" name="password" class="form-control mb-3 rounded-pill" placeholder="Palavra-passe" required>
            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">Entrar</button>
        </form>

        <div class="mt-4 small">
            Ainda não tens conta? <a href="/register" class="text-primary fw-bold text-decoration-none">Regista-te aqui</a>
        </div>
    </div>
</body>
</html>
