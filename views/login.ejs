<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Login - LegoTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; height: 100vh; }
        .card { width: 100%; max-width: 400px; }
    </style>
</head>
<body>
    <div class="card shadow border-0">
        <div class="card-body p-4">
            <h3 class="fw-bold text-center mb-4">🧱 LegoTracker</h3>
            
            <% if (locals.error) { %>
                <div class="alert alert-danger py-2 small"><%= error %></div>
            <% } %>

            <a href="/auth/google" class="btn btn-outline-dark w-100 mb-3 fw-bold">
                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="18" class="me-2">
                Entrar com Google
            </a>

            <div class="text-center text-muted small mb-3">- ou -</div>

            <form action="/login" method="POST">
                <div class="mb-3">
                    <input type="email" name="email" class="form-control" placeholder="Email" required>
                </div>
                <div class="mb-3">
                    <input type="password" name="password" class="form-control" placeholder="Password" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </form>
            
            <hr>
            <div class="text-center small">
                <p class="text-muted mb-0">Ainda não tens conta? Pede ao Admin.</p>
            </div>
        </div>
    </div>
</body>
</html>
