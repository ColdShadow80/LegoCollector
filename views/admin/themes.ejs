<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Admin Temas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4 px-3">
        <a class="navbar-brand" href="/">Admin Painel</a>
        <a href="/" class="btn btn-outline-light btn-sm">Voltar ao Site</a>
    </nav>
    <div class="container">
        <h3>Gerir Temas</h3>
        <table class="table table-striped bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Sets</th>
                    <th>Esconder?</th>
                </tr>
            </thead>
            <tbody>
                <% themes.forEach(t => { %>
                <tr>
                    <td><%= t.id %></td>
                    <td><%= t.name %></td>
                    <td><%= t.total_sets %></td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" onchange="toggle(<%= t.id %>, 'is_hidden', this.checked)" <%= t.is_hidden ? 'checked' : '' %>>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <script>
        async function toggle(id, field, val) {
            await fetch('/admin/themes/toggle', {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ theme_id: id, field: field, value: val })
            });
        }
    </script>
</body>
</html>
