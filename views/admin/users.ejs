<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= (user && user.dark_mode) ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <title>Utilizadores - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>👥 Gestão de Utilizadores</h3>
        <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">
            <div class="mb-2 mb-md-0">
                <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
                    <i class="bi bi-person-plus"></i> Novo Utilizador
                </button>
                <a href="/admin/users" class="btn btn-outline-primary btn-sm ms-2">Utilizadores</a>
            </div>
            <div class="vr d-none d-md-inline mx-2" style="height:32px;"></div>
            <div>
                <span class="fw-bold text-secondary me-2">Gestão:</span>
                <a href="/admin/themes" class="btn btn-outline-secondary btn-sm me-2">Temas</a>
                <a href="/admin/sets" class="btn btn-outline-secondary btn-sm me-2">Sets</a>
                <a href="/admin/barcodes" class="btn btn-outline-secondary btn-sm">Códigos de Barras</a>
                <a href="/" class="btn btn-outline-secondary btn-sm ms-2">Voltar ao Site</a>
            </div>
        </div>
    </div>

    <div class="mb-3 btn-group">
        <a href="/admin/users?sort=id" class="btn btn-sm btn-outline-primary <%= sort === 'id' ? 'active' : '' %>">Ordenar ID</a>
        <a href="/admin/users?sort=name" class="btn btn-sm btn-outline-primary <%= sort === 'name' ? 'active' : '' %>">Ordenar Nome</a>
        <a href="/admin/users?sort=login" class="btn btn-sm btn-outline-primary <%= sort === 'login' ? 'active' : '' %>">Tipo Login</a>
        <a href="/admin/users?sort=access" class="btn btn-sm btn-outline-primary <%= sort === 'access' ? 'active' : '' %>">Último Acesso</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Tipo Login</th>
                        <th>Ativo?</th>
                        <th>Admin</th>
                        <th>Último Acesso</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(u => { %>
                        <tr>
                            <td>#<%= u.id %></td>
                            <td class="fw-bold"><%= u.name %></td>
                            <td><%= u.email %></td>
                            <td>
                                <% if(u.google_id) { %> 
                                    <span class="badge bg-danger"><i class="bi bi-google"></i> Google</span> 
                                <% } else { %> 
                                    <span class="badge bg-secondary"><i class="bi bi-envelope"></i> Local</span> 
                                <% } %>
                            </td>
                            <td>
                                <% if(u.is_verified) { %> 
                                    <span class="badge bg-success-subtle text-success border border-success">Sim</span> 
                                <% } else { %> 
                                    <span class="badge bg-danger-subtle text-danger border border-danger">Não</span> 
                                <% } %>
                            </td>
                            <td>
                                <% if (u.is_admin) { %>
                                    <span class="badge bg-primary">Admin</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Utilizador</span>
                                <% } %>
                                <% if (u.id === 1) { %>
                                    <span class="badge bg-info ms-1">(Original)</span>
                                <% } %>
                                <% if (user.id !== u.id) { %>
                                    <button class="btn btn-sm btn-outline-<%= u.is_admin ? 'danger' : 'primary' %> ms-2" onclick="toggleAdmin(<%= u.id %>, <%= u.is_admin ? 'false' : 'true' %>, '<%= u.name %>')">
                                        <%= u.is_admin ? 'Revogar' : 'Tornar Admin' %>
                                    </button>
                                <% } %>
                            </td>
                            <td class="small text-muted">
                                <%= u.last_login ? new Date(u.last_login).toLocaleString('pt-PT') : 'Nunca' %>
                            </td>
                            <td>
                                <% if(!u.google_id) { %>
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-warning" onclick="resetPass(<%= u.id %>, 'email')" title="Enviar Email Reset">
                                            <i class="bi bi-envelope-at"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-info" onclick="resetPass(<%= u.id %>, 'link')" title="Gerar Link Manual">
                                            <i class="bi bi-link-45deg"></i>
                                        </button>
                                    </div>
                                <% } else { %>
                                    <span class="text-muted small">Gerido pela Google</span>
                                <% } %>
                            </td>
                            <script>
                                async function toggleAdmin(id, makeAdmin, name) {
                                    const action = makeAdmin === true || makeAdmin === 'true';
                                    const msg = action ? `Tem a certeza que deseja tornar ${name} um admin?` : `Tem a certeza que deseja revogar o status de admin de ${name}?`;
                                    if (!confirm(msg)) return;
                                    try {
                                        const res = await fetch('/admin/users/admin', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ user_id: id, make_admin: action })
                                        });
                                        const data = await res.json();
                                        if (data.error) {
                                            alert('❌ ' + data.error);
                                        } else {
                                            location.reload();
                                        }
                                    } catch (e) {
                                        alert('Erro ao comunicar com o servidor.');
                                    }
                                }
                            </script>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="linkModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Link de Reset Gerado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">Copie este link e envie ao utilizador:</p>
                    <div class="input-group">
                        <input type="text" id="generatedLink" class="form-control" readonly>
                        <button class="btn btn-outline-secondary" onclick="copyLink()">Copiar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Create User Modal -->
    <div class="modal fade" id="createUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Criar Novo Utilizador</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="createUserForm">
                        <div class="mb-3">
                            <label for="newUserName" class="form-label">Nome *</label>
                            <input type="text" class="form-control" id="newUserName" required placeholder="p.e., João Silva">
                        </div>
                        <div class="mb-3">
                            <label for="newUserEmail" class="form-label">Email *</label>
                            <input type="email" class="form-control" id="newUserEmail" required placeholder="usuario@example.com">
                        </div>
                        <div class="mb-3">
                            <label for="newUserPassword" class="form-label">Palavra-passe *</label>
                            <input type="password" class="form-control" id="newUserPassword" required placeholder="Mínimo 6 caracteres">
                            <div class="form-text">Insira uma palavra-passe com pelo menos 6 caracteres</div>
                        </div>
                        <div class="mb-3">
                            <label for="newUserPasswordConfirm" class="form-label">Confirmar Palavra-passe *</label>
                            <input type="password" class="form-control" id="newUserPasswordConfirm" required placeholder="Repita a palavra-passe">
                        </div>
                        <div id="createUserError" class="alert alert-danger d-none" role="alert"></div>
                        <div id="createUserSuccess" class="alert alert-success d-none" role="alert"></div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-success" id="createUserBtn" onclick="createUser()">Criar Utilizador</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        async function resetPass(id, type) {
            if(!confirm('Tem a certeza que deseja repor a palavra-passe deste utilizador?')) return;
            
            try {
                const res = await fetch('/admin/users/reset', {
                    method: 'POST', 
                    headers: {'Content-Type': 'application/json'}, 
                    body: JSON.stringify({ user_id: id, type })
                });
                const data = await res.json();
                
                if (data.error) return alert(data.error);
                
                if (type === 'email') {
                    alert('✅ Email de recuperação enviado com sucesso.');
                } else { 
                    document.getElementById('generatedLink').value = data.link; 
                    new bootstrap.Modal(document.getElementById('linkModal')).show(); 
                }
            } catch (e) {
                alert('Erro ao comunicar com o servidor.');
            }
        }

        function copyLink() {
            const copyText = document.getElementById("generatedLink");
            copyText.select();
            document.execCommand("copy");
            alert("Link copiado!");
        }

        async function createUser() {
            const name = document.getElementById('newUserName').value.trim();
            const email = document.getElementById('newUserEmail').value.trim();
            const password = document.getElementById('newUserPassword').value;
            const passwordConfirm = document.getElementById('newUserPasswordConfirm').value;
            const errorDiv = document.getElementById('createUserError');
            const successDiv = document.getElementById('createUserSuccess');
            const btn = document.getElementById('createUserBtn');

            // Clear previous messages
            errorDiv.classList.add('d-none');
            successDiv.classList.add('d-none');

            // Validation
            if (!name || !email || !password || !passwordConfirm) {
                errorDiv.textContent = '❌ Todos os campos são obrigatórios.';
                errorDiv.classList.remove('d-none');
                return;
            }

            if (password.length < 6) {
                errorDiv.textContent = '❌ A palavra-passe deve ter pelo menos 6 caracteres.';
                errorDiv.classList.remove('d-none');
                return;
            }

            if (password !== passwordConfirm) {
                errorDiv.textContent = '❌ As palavras-passe não coincidem.';
                errorDiv.classList.remove('d-none');
                return;
            }

            // Disable button and show loading state
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Criando...';

            try {
                const res = await fetch('/admin/users/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, password })
                });

                const data = await res.json();

                if (data.error) {
                    errorDiv.textContent = '❌ ' + data.error;
                    errorDiv.classList.remove('d-none');
                } else {
                    successDiv.innerHTML = '✅ Utilizador criado com sucesso! A página vai recarregar em 2 segundos...';
                    successDiv.classList.remove('d-none');
                    setTimeout(() => {
                        location.reload();
                    }, 2000);
                }
            } catch (e) {
                errorDiv.textContent = '❌ Erro ao comunicar com o servidor.';
                errorDiv.classList.remove('d-none');
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Criar Utilizador';
            }
        }

        // Allow form submission with Enter key
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('newUserPasswordConfirm').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    createUser();
                }
            });
        });
    </script>
</body>
</html>
