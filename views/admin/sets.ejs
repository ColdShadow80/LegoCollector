<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Admin Sets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4 px-3">
        <a class="navbar-brand" href="/">🧱 Admin Painel</a>
        <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">
            <div>
                <span class="fw-bold text-secondary me-2">Gestão:</span>
                <a href="/admin/themes" class="btn btn-outline-light btn-sm me-2">Temas</a>
                <a href="/admin/sets" class="btn btn-outline-light btn-sm me-2">Sets</a>
                <a href="/admin/barcodes" class="btn btn-outline-light btn-sm">Códigos de Barras</a>
            </div>
            <div class="vr d-none d-md-inline mx-2" style="height:32px;"></div>
            <div>
                <a href="/admin/users" class="btn btn-outline-primary btn-sm me-2">Utilizadores</a>
                <a href="/" class="btn btn-outline-light btn-sm me-2">Voltar ao Site</a>
                <a href="/admin/sets?export=csv" class="btn btn-outline-light btn-sm">Exportar CSV</a>
            </div>
        </div>
    </nav>
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Gerir Sets</h3>
            <input id="setSearch" class="form-control form-control-sm w-50" placeholder="Procurar sets (numero / nome)...">
        </div>

        <table class="table table-striped bg-white shadow-sm rounded align-middle">
            <thead>
                <tr>
                    <th><a href="?sort=set_num&dir=<%= sort === 'set_num' && sortDir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none">Set<% if(sort==='set_num'){ %> <i class="bi bi-caret-<%= sortDir==='ASC'?'up':'down' %>-fill"></i><% } %></a></th>
                    <th style="width:56px;text-align:center;">Imagem</th>
                    <th><a href="?sort=name&dir=<%= sort === 'name' && sortDir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none">Nome<% if(sort==='name'){ %> <i class="bi bi-caret-<%= sortDir==='ASC'?'up':'down' %>-fill"></i><% } %></a></th>
                    <th><a href="?sort=theme_name&dir=<%= sort === 'theme_name' && sortDir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none">Tema<% if(sort==='theme_name'){ %> <i class="bi bi-caret-<%= sortDir==='ASC'?'up':'down' %>-fill"></i><% } %></a></th>
                    <th><a href="?sort=year&dir=<%= sort === 'year' && sortDir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none">Ano<% if(sort==='year'){ %> <i class="bi bi-caret-<%= sortDir==='ASC'?'up':'down' %>-fill"></i><% } %></a></th>
                    <th><a href="?sort=num_parts&dir=<%= sort === 'num_parts' && sortDir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none">Peças<% if(sort==='num_parts'){ %> <i class="bi bi-caret-<%= sortDir==='ASC'?'up':'down' %>-fill"></i><% } %></a></th>
                    <th><a href="?sort=price_eur&dir=<%= sort === 'price_eur' && sortDir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none">Preço<% if(sort==='price_eur'){ %> <i class="bi bi-caret-<%= sortDir==='ASC'?'up':'down' %>-fill"></i><% } %></a></th>
                    <th>Esconder?</th>
                    <th>Ignorar Peças?</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="setsBody">
                <% sets.forEach(set => { %>
                <tr data-term="<%= (set.set_num + ' ' + (set.name||'') + ' ' + (set.theme_name||'')) .toLowerCase() %>">
                    <td><%= set.set_num %></td>
                    <td style="width:56px;text-align:center;vertical-align:middle;">
                        <div style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:#f8f9fa;border-radius:6px;overflow:hidden;margin:auto;">
                            <% if (set.img_url) { %>
                                <img src="<%= set.img_url %>" alt="img" style="max-width:44px;max-height:44px;object-fit:contain;display:block;">
                            <% } else { %>
                                <span style="color:#ccc;font-size:22px;">&#9632;</span>
                            <% } %>
                        </div>
                    </td>
                    <td style="vertical-align:middle;"><%= set.name %></td>
                    <td style="vertical-align:middle;"><%= set.theme_name || '' %></td>
                    <td><%= set.year %></td>
                    <td><%= set.num_parts %></td>
                    <td><%= set.price_eur ? ('€' + set.price_eur) : '' %></td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" onchange="toggle('<%= set.set_num %>', 'is_hidden', this.checked)" <%= set.is_hidden ? 'checked' : '' %>>
                        </div>
                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" onchange="toggle('<%= set.set_num %>', 'ignore_parts', this.checked)" <%= set.ignore_parts ? 'checked' : '' %>>
                        </div>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="openEdit('<%= set.set_num %>', '<%= (set.name||'').replace(/'/g, "\\'") %>', '<%= set.year %>', '<%= set.price_eur %>')">Editar</button>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <div class="d-flex justify-content-between">
            <% if(pagination.page > 1) { %><a href="?page=<%= pagination.page - 1 %>" class="btn btn-secondary">Anterior</a><% } %>
            <span>Página <%= pagination.page %> de <%= pagination.totalPages %></span>
            <% if(pagination.page < pagination.totalPages) { %><a href="?page=<%= pagination.page + 1 %>" class="btn btn-secondary">Próximo</a><% } %>
        </div>
    </div>

    <!-- Edit Set Modal -->
    <div class="modal fade" id="editSetModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Set</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editSetNum">
                    <label class="small text-muted">Nome</label>
                    <input id="editSetName" class="form-control mb-2">
                    <label class="small text-muted">Ano</label>
                    <input id="editSetYear" class="form-control mb-2">
                    <label class="small text-muted">Preço (€)</label>
                    <input id="editSetPrice" class="form-control mb-2">
                    <div class="form-check">
                        <input id="editSetHidden" class="form-check-input" type="checkbox">
                        <label class="form-check-label">Esconder set</label>
                    </div>
                    <div class="form-check mt-1">
                        <input id="editSetIgnoreParts" class="form-check-input" type="checkbox">
                        <label class="form-check-label">Ignorar numeração de peças</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary" id="saveSetBtn">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('setSearch').addEventListener('input', (e) => {
            const q = e.target.value.trim().toLowerCase();
            document.querySelectorAll('#setsBody tr').forEach(r => {
                r.style.display = (!q || r.dataset.term.includes(q)) ? '' : 'none';
            });
        });

        async function toggle(id, field, val) {
            await fetch('/admin/sets/toggle', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ set_num: id, field: field, value: val }) });
        }

        function openEdit(setNum, name, year, price) {
            // Find the row for this set
            const row = Array.from(document.querySelectorAll('#setsBody tr')).find(r => r.querySelector('td') && r.querySelector('td').textContent.trim() === setNum);
            let is_hidden = false, ignore_parts = false;
            if (row) {
                const hideSwitch = row.querySelector('input[type="checkbox"][onchange*="is_hidden"]');
                const ignoreSwitch = row.querySelector('input[type="checkbox"][onchange*="ignore_parts"]');
                is_hidden = hideSwitch ? hideSwitch.checked : false;
                ignore_parts = ignoreSwitch ? ignoreSwitch.checked : false;
            }
            document.getElementById('editSetNum').value = setNum;
            document.getElementById('editSetName').value = name || '';
            document.getElementById('editSetYear').value = year || '';
            document.getElementById('editSetPrice').value = price || '';
            document.getElementById('editSetHidden').checked = is_hidden;
            document.getElementById('editSetIgnoreParts').checked = ignore_parts;
            new bootstrap.Modal(document.getElementById('editSetModal')).show();
        }

        document.getElementById('saveSetBtn').addEventListener('click', async () => {
            const set_num = document.getElementById('editSetNum').value;
            const name = document.getElementById('editSetName').value.trim();
            const year = document.getElementById('editSetYear').value.trim();
            const price = document.getElementById('editSetPrice').value.trim();
            const is_hidden = document.getElementById('editSetHidden').checked;
            const ignore_parts = document.getElementById('editSetIgnoreParts').checked;
            const res = await fetch('/admin/sets/update', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ set_num, name, year, price_eur: price, is_hidden, ignore_parts }) });
            if (res.ok) location.reload(); else alert('Erro ao guardar');
        });
    </script>
</body>
</html>
