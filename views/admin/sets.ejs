<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= user.dark_mode ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <title>Gestão de Sets - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-body-tertiary">
    <nav class="navbar navbar-dark bg-dark mb-4 px-3 shadow">
        <span class="navbar-brand fw-bold">🧱 Admin: Sets</span>
        <div class="d-flex gap-2">
            <a href="/admin/themes" class="btn btn-sm btn-outline-light">Temas</a>
            <a href="/admin/users" class="btn btn-sm btn-outline-light">Users</a>
            <a href="/" class="btn btn-primary btn-sm ms-2">Voltar</a>
        </div>
    </nav>

    <div class="container-fluid px-4 pb-5">
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Set #</th>
                            <th>Nome</th>
                            <th>Ano</th>
                            <th>Tema</th>
                            <th class="text-center">Esconder?</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% sets.forEach(set => { %>
                        <tr>
                            <td class="fw-bold text-primary"><%= set.set_num %></td>
                            <td><%= set.name %></td>
                            <td><%= set.year %></td>
                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis"><%= set.theme_name %></span></td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block">
                                    <input class="form-check-input" type="checkbox" onchange="toggleSet('<%= set.set_num %>', 'is_hidden', this.checked)" <%= set.is_hidden ? 'checked' : '' %>>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if (pagination.totalPages > 1) { %>
            <nav class="mt-4 d-flex justify-content-center">
                <ul class="pagination pagination-sm">
                    <% for(let i=1; i <= pagination.totalPages; i++) { %>
                        <li class="page-item <%= pagination.page == i ? 'active' : '' %>">
                            <a class="page-link" href="/admin/sets?page=<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        <% } %>
    </div>

    <script>
        async function toggleSet(num, field, val) {
            await fetch('/admin/sets/toggle', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ set_num: num, field: field, value: val ? 1 : 0 })
            });
        }
    </script>
</body>
</html>
