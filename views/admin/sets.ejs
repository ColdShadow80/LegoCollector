<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= user.dark_mode ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <title>Gerir Sets - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .sidebar-scroll { max-height: 60vh; overflow-y: auto; }
        .set-thumb { width: 50px; height: 50px; object-fit: contain; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg border-bottom mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="/admin/themes">🛠️ Admin</a>
        <div class="d-flex gap-3">
            <a href="/" class="btn btn-outline-secondary btn-sm">Voltar ao Site</a>
            <div class="dropdown">
                <button class="btn btn-sm btn-secondary dropdown-toggle" data-bs-toggle="dropdown">Admin Menu</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/admin/sets">🧱 Gerir Sets</a></li>
                    <li><a class="dropdown-item" href="/admin/themes">🎨 Gerir Temas</a></li>
                    <li><a class="dropdown-item" href="/admin/users">👥 Gerir Utilizadores</a></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-md-3 col-lg-2 mb-4">
            <form action="/admin/sets" method="GET" id="filterForm">
                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
                    <a href="/admin/sets" class="btn btn-outline-secondary btn-sm">Limpar</a>
                </div>

                <div class="mb-3">
                    <label class="small fw-bold">Pesquisa</label>
                    <input type="text" name="search" class="form-control form-control-sm" value="<%= query.search || '' %>">
                </div>

                <div class="mb-3">
                    <label class="small fw-bold">Ano</label>
                    <select name="year" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        <% allYears.forEach(y => { %>
                            <option value="<%= y.year %>" <%= query.year == y.year ? 'selected' : '' %>><%= y.year %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="small fw-bold">Temas</label>
                    <input type="text" id="themeSearchInput" class="form-control form-control-sm mb-2" placeholder="Filtrar...">
                    <div class="sidebar-scroll border rounded p-2 bg-body-tertiary" id="themeListContainer">
                        <% allThemes.forEach(t => { %>
                            <div class="form-check mb-1 theme-item">
                                <input class="form-check-input" type="checkbox" name="themes" value="<%= t.name %>" id="t-<%= t.name %>"
                                <% if (query.themes && (query.themes === t.name || (Array.isArray(query.themes) && query.themes.includes(t.name)))) { %> checked <% } %>>
                                <label class="form-check-label small lh-sm" for="t-<%= t.name %>">
                                    <span class="d-block text-truncate label-text" style="max-width: 180px;"><%= t.name %></span>
                                </label>
                            </div>
                        <% }) %>
                    </div>
                </div>
                <input type="hidden" name="page" value="1">
            </form>
        </div>

        <div class="col-md-9 col-lg-10">
            <h5 class="mb-3">Gestão de Sets (<%= pagination.totalItems %> encontrados)</h5>
            
            <div class="table-responsive">
                <table class="table table-sm table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">Img</th>
                            <th>Set #</th>
                            <th>Nome</th>
                            <th>Ano</th>
                            <th>Peças</th>
                            <th class="text-center bg-warning-subtle">Ocultar</th>
                            <th class="text-center bg-danger-subtle">Ignorar Sync</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% sets.forEach(s => { %>
                            <tr>
                                <td class="text-center"><img src="<%= s.img_url %>" class="set-thumb" loading="lazy"></td>
                                <td class="fw-bold"><%= s.set_num %></td>
                                <td>
                                    <span class="d-block text-truncate" style="max-width: 300px;" title="<%= s.name %>"><%= s.name %></span>
                                    <small class="text-muted"><%= s.theme_name %></small>
                                </td>
                                <td><%= s.year %></td>
                                <td><%= s.num_parts %></td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <input class="form-check-input" type="checkbox" <%= s.is_hidden ? 'checked' : '' %> onchange="toggleSet('<%= s.set_num %>', 'is_hidden', this.checked)">
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <input class="form-check-input" type="checkbox" <%= s.ignore_parts ? 'checked' : '' %> onchange="toggleSet('<%= s.set_num %>', 'ignore_parts', this.checked)">
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <% if (pagination.totalPages > 1) { %>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button class="btn btn-sm btn-outline-primary" <%= pagination.page == 1 ? 'disabled' : '' %> onclick="changePage(<%= pagination.page - 1 %>)">Anterior</button>
                    <span class="align-self-center small">Pág <%= pagination.page %> de <%= pagination.totalPages %></span>
                    <button class="btn btn-sm btn-outline-primary" <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %> onclick="changePage(<%= pagination.page + 1 %>)">Próximo</button>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('themeSearchInput').addEventListener('keyup', function(e) {
        const term = e.target.value.toLowerCase();
        document.querySelectorAll('.theme-item').forEach(item => {
            const text = item.querySelector('.label-text').textContent.toLowerCase();
            item.style.display = text.includes(term) ? '' : 'none';
        });
    });

    function changePage(p) {
        const form = document.getElementById('filterForm');
        form.querySelector('input[name="page"]').value = p;
        form.submit();
    }

    async function toggleSet(id, field, value) {
        try {
            await fetch('/admin/sets/toggle', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ set_num: id, field, value })
            });
        } catch(e) { alert('Erro ao guardar!'); }
    }
</script>
</body>
</html>
