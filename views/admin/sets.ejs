<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Admin Sets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4 px-3">
        <a class="navbar-brand" href="/">Admin Painel</a>
        <a href="/" class="btn btn-outline-light btn-sm">Voltar ao Site</a>
    </nav>
    <div class="container">
        <h3>Gerir Sets</h3>
        <table class="table table-striped bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Set</th>
                    <th>Nome</th>
                    <th>Esconder?</th>
                    <th>Ignorar Peças?</th>
                </tr>
            </thead>
            <tbody>
                <% sets.forEach(set => { %>
                <tr>
                    <td><%= set.set_num %></td>
                    <td><%= set.name %></td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" onchange="toggle('<%= set.set_num %>', 'is_hidden', this.checked)" <%= set.is_hidden ? 'checked' : '' %>>
                        </div>
                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" onchange="toggle('<%= set.set_num %>', 'ignore_parts', this.checked)" <%= set.ignore_parts ? 'checked' : '' %>>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        <div class="d-flex justify-content-between">
            <% if(pagination.page > 1) { %><a href="?page=<%= pagination.page - 1 %>" class="btn btn-secondary">Anterior</a><% } %>
            <span>Página <%= pagination.page %> de <%= pagination.totalPages %></span>
            <% if(pagination.page < pagination.totalPages) { %><a href="?page=<%= pagination.page + 1 %>" class="btn btn-secondary">Próximo</a><% } %>
        </div>
    </div>
    <script>
        async function toggle(id, field, val) {
            await fetch('/admin/sets/toggle', {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ set_num: id, field: field, value: val })
            });
        }
    </script>
</body>
</html>
