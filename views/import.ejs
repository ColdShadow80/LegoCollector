<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= user && user.dark_mode ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <title>Importar/Exportar - LegoTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>

<nav class="navbar navbar-expand-lg border-bottom mb-4 bg-body">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="/">🧱 LegoTracker</a>
        <div class="d-flex gap-3">
            <a href="/" class="btn btn-outline-secondary btn-sm">Voltar</a>
        </div>
    </div>
</nav>

<div class="container py-4">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-arrow-up"></i> Importar CSV</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Suporta ficheiros exportados do Rebrickable ou Brickset.</p>
                    
                    <% if (locals.success) { %>
                        <div class="alert alert-success"><%= success %></div>
                    <% } %>
                    <% if (locals.error) { %>
                        <div class="alert alert-danger"><%= error %></div>
                    <% } %>

                    <form action="/api/import" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Ficheiro CSV</label>
                            <input class="form-control" type="file" name="csvfile" required accept=".csv">
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Carregar Coleção</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-arrow-down"></i> Exportar Coleção</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <p class="text-muted">Faz download de toda a tua coleção num ficheiro CSV compatível com Excel.</p>
                    <a href="/api/export" class="btn btn-success w-100 mt-3"><i class="bi bi-download"></i> Download CSV</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
