<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= (user && user.dark_mode) ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LegoTracker V11.2</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    
    <style>
        body { transition: background-color 0.3s; }
        .set-card img { height: 160px; object-fit: contain; padding: 10px; width: 100%; transition: transform 0.2s; }
        .set-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
        .is-owned { border: 2px solid #198754 !important; background-color: rgba(25, 135, 84, 0.05); }
        .is-wanted { border: 2px solid #dc3545 !important; background-color: rgba(220, 53, 69, 0.05); }
        .sidebar-scroll { max-height: 50vh; overflow-y: auto; scrollbar-width: thin; }
        #reader { width: 100%; border-radius: 12px; overflow: hidden; background: #000; }
        .theme-item-row { transition: background 0.2s; border-radius: 4px; padding: 2px 5px; }
        .theme-item-row:hover { background: rgba(0,0,0,0.05); }
        [data-bs-theme="dark"] .theme-item-row:hover { background: rgba(255,255,255,0.1); }
        .badge-status { position: absolute; top: 10px; right: 10px; z-index: 2; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg border-bottom mb-4 shadow-sm sticky-top bg-body">
    <div class="container-fluid px-3 px-lg-4">
        <a class="navbar-brand fw-bold text-primary" href="/">🧱 LegoTracker</a>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <% if (user) { %>
                    <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/?status=owned"><i class="bi bi-box-seam"></i> Minha Coleção</a></li>
                    <li class="nav-item"><a class="nav-link" href="/?status=wanted"><i class="bi bi-heart"></i> Wishlist</a></li>
                <% } %>
            </ul>
            
            <div class="d-flex align-items-center gap-3">
                <% if (user) { %>
                    <button class="btn btn-warning fw-bold rounded-pill btn-sm shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#scanModal">
                        <i class="bi bi-upc-scan"></i> SCAN
                    </button>
                    
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary rounded-pill dropdown-toggle btn-sm px-3" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> <%= user.name.split(' ')[0] %>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li><a class="dropdown-item" href="/import"><i class="bi bi-arrow-down-up me-2"></i> Import/Export</a></li>
                            <li><a class="dropdown-item" href="/manual"><i class="bi bi-book me-2"></i> Manual</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <% if (user.id === 1) { %>
                                <li><h6 class="dropdown-header text-danger">Administração</h6></li>
                                <li><a class="dropdown-item" href="/admin/sets">Gerir Sets</a></li>
                                <li><a class="dropdown-item" href="/admin/themes">Gerir Temas</a></li>
                                <li><a class="dropdown-item" href="/admin/users">Gerir Users</a></li>
                                <li><hr class="dropdown-divider"></li>
                            <% } %>
                            <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i> Sair</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <a href="/login" class="btn btn-primary rounded-pill px-4 fw-bold">Entrar / Registar</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>

<div class="modal fade" id="scanModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title fs-6"><i class="bi bi-qr-code-scan"></i> Scanner de Código de Barras</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="stopScanner()"></button>
            </div>
            <div class="modal-body p-0 bg-black position-relative">
                <div id="reader"></div>
                
                <div id="scanResult" class="p-4 bg-body text-center" style="display:none;">
                    <img id="resImg" src="" class="rounded mb-3 shadow-sm" style="height: 150px; object-fit: contain;">
                    <h5 id="resName" class="fw-bold mb-1"></h5>
                    <div id="resStatus" class="mb-3"></div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-danger flex-fill" onclick="performAction('WANTED')">Quero</button>
                        <button class="btn btn-success flex-fill" onclick="performAction('OWNED')">Tenho</button>
                    </div>
                    <button class="btn btn-link btn-sm mt-3 text-decoration-none" onclick="resetScanner()">Ler outro código</button>
                </div>
            </div>
            <div class="modal-footer bg-dark border-0 p-2 d-block">
                <div class="mb-2">
                    <select class="form-select form-select-sm bg-black text-white border-secondary" id="cameraSelection"></select>
                </div>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-secondary border-0 text-white">#</span>
                    <input type="number" id="manualSetNum" class="form-control bg-black text-white border-secondary" placeholder="Nº do Set manual...">
                    <button class="btn btn-primary" onclick="manualSearch()">Procurar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4">
    <div class="row">
        <aside class="col-md-3 col-lg-2">
            <div class="card border-0 shadow-sm p-3 mb-4">
                <form action="/" method="GET" id="filterForm">
                    <div class="mb-3">
                        <label class="small fw-bold text-uppercase text-muted">Pesquisa</label>
                        <input type="text" name="search" class="form-control form-control-sm" value="<%= query.search || '' %>" placeholder="Nome ou número...">
                    </div>
                    
                    <div class="mb-3">
                        <label class="small fw-bold text-uppercase text-muted">Ano</label>
                        <select name="year" class="form-select form-select-sm">
                            <option value="">Todos os anos</option>
                            <% allYears.forEach(y => { %>
                                <option value="<%= y.year %>" <%= query.year == y.year ? 'selected' : '' %>><%= y.year %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="small fw-bold text-uppercase text-muted">Filtrar Temas</label>
                        <input type="text" id="themeFilter" class="form-control form-control-sm mb-2" placeholder="Filtrar lista...">
                        <div class="sidebar-scroll border rounded p-2 bg-body-tertiary">
                            <% allThemes.forEach(t => { %>
                                <div class="form-check small theme-item-row">
                                    <input class="form-check-input" type="checkbox" name="themes" value="<%= t.name %>" 
                                        <%= (query.themes && (Array.isArray(query.themes) ? query.themes.includes(t.name) : query.themes === t.name)) ? 'checked' : '' %>>
                                    <label class="form-check-label"><%= t.name %></label>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm w-100 shadow-sm">Aplicar Filtros</button>
                    <a href="/" class="btn btn-link btn-sm w-100 mt-1 text-decoration-none text-muted">Limpar</a>
                    <input type="hidden" name="status" value="<%= query.status || '' %>">
                </form>
            </div>
        </aside>

        <main class="col-md-9 col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                <h5 class="fw-bold mb-0">
                    <% if(query.status === 'owned') { %> 📦 Minha Coleção <% } else if(query.status === 'wanted') { %> ❤️ Lista de Desejos <% } else { %> 🧱 Catálogo Lego <% } %>
                    <span class="text-muted fw-normal fs-6 ms-2">(<%= pagination.totalItems %>)</span>
                </h5>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3">
                <% if (sets.length > 0) { %>
                    <% sets.forEach(set => { %>
                    <div class="col">
                        <div class="card h-100 shadow-sm set-card border-0 position-relative <%= set.user_status === 'OWNED' ? 'is-owned' : (set.user_status === 'WANTED' ? 'is-wanted' : '') %>">
                            
                            <% if(set.user_status) { %>
                                <div class="badge-status">
                                    <span class="badge rounded-pill <%= set.user_status === 'OWNED' ? 'bg-success' : 'bg-danger' %>">
                                        <i class="bi <%= set.user_status === 'OWNED' ? 'bi-check' : 'bi-heart-fill' %>"></i>
                                    </span>
                                </div>
                            <% } %>

                            <a href="/set/<%= set.set_num %>">
                                <img src="<%= set.img_url || 'https://via.placeholder.com/150?text=Sem+Foto' %>" class="card-img-top" loading="lazy">
                            </a>
                            
                            <div class="card-body p-2 text-center d-flex flex-column">
                                <h6 class="card-title text-truncate small fw-bold mb-1" title="<%= set.name %>"><%= set.name %></h6>
                                <div class="mt-auto">
                                    <small class="text-muted d-block mb-2">#<%= set.set_num %> · <%= set.year %></small>
                                    
                                    <% if (user) { %>
                                        <div class="btn-group w-100 shadow-sm border rounded-pill overflow-hidden">
                                            <button class="btn btn-sm btn-light border-end" onclick="updateStatus('<%= set.set_num %>', 'WANTED')" title="Wishlist">
                                                <i class="bi bi-heart<%= set.user_status === 'WANTED' ? '-fill text-danger' : '' %>"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light" onclick="updateStatus('<%= set.set_num %>', 'OWNED')" title="Tenho">
                                                <i class="bi bi-check-lg <%= set.user_status === 'OWNED' ? 'text-success fw-bold' : '' %>"></i>
                                            </button>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-search fs-1 text-muted"></i>
                        <p class="mt-2 text-muted">Nenhum set encontrado com estes filtros.</p>
                    </div>
                <% } %>
            </div>

            <% if (pagination.totalPages > 1) { %>
            <nav class="mt-5 d-flex justify-content-center">
                <ul class="pagination pagination-sm shadow-sm">
                    <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="#" onclick="changePage(<%= pagination.page - 1 %>)">&laquo;</a>
                    </li>
                    
                    <li class="page-item active"><span class="page-link"><%= pagination.page %> de <%= pagination.totalPages %></span></li>
                    
                    <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="#" onclick="changePage(<%= pagination.page + 1 %>)">&raquo;</a>
                    </li>
                </ul>
            </nav>
            <% } %>
        </main>
    </div>
</div>

<script>
    // 1. FILTRO DE TEMAS EM TEMPO REAL
    document.getElementById('themeFilter').addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase();
        document.querySelectorAll('.theme-item-row').forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(val) ? 'block' : 'none';
        });
    });

    // 2. ATUALIZAÇÃO DE STATUS (API)
    async function updateStatus(num, stat) {
        try {
            const res = await fetch('/api/toggle', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ set_num: num, status: stat })
            });
            if(res.ok) window.location.reload();
        } catch (err) { console.error("Erro ao atualizar:", err); }
    }

    // 3. PAGINAÇÃO
    function changePage(p) {
        const params = new URLSearchParams(window.location.search);
        params.set('page', p);
        window.location.search = params.toString();
    }

    // 4. LÓGICA DO SCANNER (HTML5-QRCODE)
    let html5QrCode;
    const scanModal = document.getElementById('scanModal');
    if(scanModal) scanModal.addEventListener('shown.bs.modal', startScanner);

    async function startScanner() {
        try {
            const cameras = await Html5Qrcode.getCameras();
            const camSelect = document.getElementById('cameraSelection');
            camSelect.innerHTML = cameras.map(c => `<option value="${c.id}">${c.label}</option>`).join('');
            
            camSelect.onchange = async () => { 
                if(html5QrCode) await html5QrCode.stop(); 
                initReader(camSelect.value); 
            };
            
            initReader(cameras[0].id);
        } catch (err) { console.error("Erro ao aceder câmara:", err); }
    }

    function initReader(id) {
        html5QrCode = new Html5Qrcode("reader");
        html5QrCode.start(id, { fps: 10, qrbox: 250 }, async (txt) => {
            html5QrCode.pause();
            const res = await fetch(`/api/scan?code=${txt}`);
            const data = await res.json();
            
            if(data.found) {
                document.getElementById('scanResult').style.display = 'block';
                document.getElementById('reader').style.display = 'none';
                document.getElementById('resImg').src = data.set.img_url;
                document.getElementById('resName').innerText = data.set.name;
                window.currentSetNum = data.set.set_num;
                
                const statusDiv = document.getElementById('resStatus');
                statusDiv.innerHTML = data.set.user_status ? 
                    `<span class="badge bg-info">${data.set.user_status}</span>` : 
                    `<span class="text-muted small">Não está na tua coleção</span>`;
            } else {
                alert("Set não reconhecido!");
                html5QrCode.resume();
            }
        });
    }

    async function manualSearch() {
        const num = document.getElementById('manualSetNum').value;
        if(num) window.location.href = `/set/${num}`;
    }

    function stopScanner() { if(html5QrCode) html5QrCode.stop(); }
    function resetScanner() { 
        document.getElementById('scanResult').style.display = 'none'; 
        document.getElementById('reader').style.display = 'block'; 
        if(html5QrCode) html5QrCode.resume(); 
    }
    async function performAction(s) { if(window.currentSetNum) updateStatus(window.currentSetNum, s); }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
