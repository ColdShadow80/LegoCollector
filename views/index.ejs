<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= (user && user.dark_mode) ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LegoTracker V11</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

    <style>
        body { transition: background-color 0.3s, color 0.3s; }
        .set-card img { height: 160px; object-fit: contain; padding: 5px; transition: transform 0.2s; }
        .set-card:hover img { transform: scale(1.05); }
        [data-bs-theme="dark"] .card { background-color: #2b3035; border-color: #495057; }
        [data-bs-theme="dark"] .is-owned { background-color: #1a4d2e !important; border-color: #2ea043; }
        [data-bs-theme="light"] .is-owned { border: 2px solid #198754; background-color: #f0fff4; }
        [data-bs-theme="dark"] .is-wanted { background-color: #4a1e2c !important; border-color: #e91e63; }
        [data-bs-theme="light"] .is-wanted { border: 2px solid #e91e63; background-color: #fff0f5; }
        .badge-owned { position: absolute; top: 5px; right: 5px; font-size: 0.7em; }
        .sidebar-scroll { max-height: 60vh; overflow-y: auto; }
        .pagination-select { border: none; background-color: transparent; font-weight: bold; text-align: center; cursor: pointer; }
        .card-actions .btn { border-radius: 50%; width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; }

        #reader { width: 100%; border-radius: 8px; overflow: hidden; background: #000; }
        #reader video { object-fit: cover; border-radius: 8px; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg border-bottom mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="/">🧱 LegoTracker</a>
        
        <div class="d-flex align-items-center gap-3">
            <% if (user) { %>
                <button class="btn btn-warning btn-sm fw-bold rounded-pill" data-bs-toggle="modal" data-bs-target="#scanModal">
                    <i class="bi bi-upc-scan"></i> Scan
                </button>

                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">👤 <%= user.name %></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <% if (user.id === 1) { %>
                            <li><h6 class="dropdown-header">Admin</h6></li>
                            <li><a class="dropdown-item" href="/admin/sets">Sets</a></li>
                            <li><a class="dropdown-item" href="/admin/themes">Temas</a></li>
                            <li><hr class="dropdown-divider"></li>
                        <% } %>
                        <li><a class="dropdown-item text-primary" href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li><a class="dropdown-item" href="/import"><i class="bi bi-arrow-down-up"></i> Import/Export</a></li>
                        <li><a class="dropdown-item" href="/manual"><i class="bi bi-book"></i> Manual do Utilizador</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/logout">Sair</a></li>
                    </ul>
                </div>
            <% } else { %>
                <a href="/login" class="btn btn-primary btn-sm rounded-pill px-3">Entrar</a>
            <% } %>
        </div>
    </div>
</nav>

<div class="modal fade" id="scanModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-qr-code-scan"></i> Scanner</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="stopScanner()"></button>
            </div>
            <div class="modal-body p-0 position-relative bg-dark">
                <div id="reader"></div>
                <div class="p-2 bg-dark text-white border-top border-secondary" id="scannerControls">
                    <div class="input-group input-group-sm mb-2">
                        <label class="input-group-text bg-secondary text-white border-secondary"><i class="bi bi-camera-video"></i></label>
                        <select class="form-select bg-dark text-white border-secondary" id="cameraSelection">
                            <option value="">A carregar...</option>
                        </select>
                    </div>
                    <div id="zoomContainer" class="d-none px-1">
                        <label class="form-label small d-flex justify-content-between mb-0"><span><i class="bi bi-zoom-out"></i></span><span>Zoom</span><span><i class="bi bi-zoom-in"></i></span></label>
                        <input type="range" class="form-range" id="zoomSlider" min="1" max="5" step="0.1" value="1">
                    </div>
                </div>
                <div id="scanResult" class="p-3 bg-body text-center" style="display:none;">
                    <h5 class="text-success fw-bold mb-3"><i class="bi bi-check-circle-fill"></i> Encontrado!</h5>
                    <div class="card shadow-sm mx-auto mb-3" style="max-width: 250px;">
                        <img id="resImg" src="" class="card-img-top p-2" style="height: 150px; object-fit: contain;">
                        <div class="card-body p-2">
                            <h6 id="resName" class="card-title text-truncate small fw-bold"></h6>
                            <span id="resNum" class="badge bg-secondary"></span>
                            <span id="resStatus" class="d-block mt-1 small"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-outline-danger w-100" onclick="performAction('WANTED')"><i class="bi bi-heart"></i> Quero</button>
                        <button class="btn btn-success w-100" onclick="performAction('OWNED')"><i class="bi bi-check-lg"></i> Tenho</button>
                    </div>
                    <button class="btn btn-link btn-sm mt-3" onclick="resetScanner()">Ler outro</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-md-3 col-lg-2 mb-4">
            <form action="/" method="GET" id="filterForm">
                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary btn-sm">Aplicar</button>
                    <a href="/" class="btn btn-outline-secondary btn-sm">Limpar</a>
                </div>
                <div class="mb-3"><label class="small fw-bold">Pesquisa</label><input type="text" name="search" class="form-control form-control-sm" value="<%= query.search || '' %>"></div>
                <div class="mb-3"><label class="small fw-bold">Estado</label><select name="status" class="form-select form-select-sm"><option value="">Tudo</option><option value="owned" <%= query.status == 'owned' ? 'selected' : '' %>>Tenho</option><option value="wanted" <%= query.status == 'wanted' ? 'selected' : '' %>>Quero</option></select></div>
                <div class="mb-3"><label class="small fw-bold">Ano</label><select name="year" class="form-select form-select-sm"><option value="">Todos</option><% allYears.forEach(y => { %><option value="<%= y.year %>" <%= query.year == y.year ? 'selected' : '' %>><%= y.year %></option><% }) %></select></div>
                <div class="mb-3"><label class="small fw-bold">Temas</label><input type="text" id="themeSearchInput" class="form-control form-control-sm mb-2" placeholder="Filtrar..."><div class="sidebar-scroll border rounded p-2 bg-body-tertiary" id="themeListContainer"><% allThemes.forEach(t => { %><div class="form-check mb-1 theme-item"><input class="form-check-input" type="checkbox" name="themes" value="<%= t.name %>" id="t-<%= t.name %>" <% if (query.themes && (query.themes === t.name || (Array.isArray(query.themes) && query.themes.includes(t.name)))) { %> checked <% } %>><label class="form-check-label small lh-sm" for="t-<%= t.name %>"><span class="d-block text-truncate label-text" style="max-width: 180px;"><%= t.name %></span></label></div><% }) %></div></div>
                <input type="hidden" name="limit" id="limitInput" value="<%= pagination.limit %>"><input type="hidden" name="page" value="<%= pagination.page %>"><input type="hidden" name="sort" id="sortInput" value="<%= query.sort || '' %>">
            </form>
        </div>
        <div class="col-md-9 col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <span class="text-muted small"><%= pagination.totalItems %> sets</span>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" style="width: auto;" onchange="changeSort(this.value)"><option value="" <%= !query.sort ? 'selected' : '' %>>Padrão</option><option value="year_desc" <%= query.sort == 'year_desc' ? 'selected' : '' %>>Ano (Recente)</option><option value="year_asc" <%= query.sort == 'year_asc' ? 'selected' : '' %>>Ano (Antigo)</option><option value="parts_desc" <%= query.sort == 'parts_desc' ? 'selected' : '' %>>Peças</option><option value="name_asc" <%= query.sort == 'name_asc' ? 'selected' : '' %>>Nome</option><option value="added_desc" <%= query.sort == 'added_desc' ? 'selected' : '' %>>Adicionado</option></select>
                    <select class="form-select form-select-sm" style="width: 80px;" onchange="changeLimit(this.value)"><option value="25" <%= pagination.limit == 25 ? 'selected' : '' %>>25</option><option value="50" <%= pagination.limit == 50 ? 'selected' : '' %>>50</option><option value="100" <%= pagination.limit == 100 ? 'selected' : '' %>>100</option></select>
                </div>
            </div>
            <% if (sets.length === 0) { %><div class="text-center py-5 text-muted"><h3>👻</h3><p>Nada.</p></div><% } %>
            <div class="accordion" id="accordionThemes">
            <% let lastTheme = null; sets.forEach((set, index) => { let showHeader = (!query.sort) && (set.theme_name !== lastTheme); if (showHeader) { if (lastTheme !== null) { %> </div></div></div> <% } lastTheme = set.theme_name; let themeId = 'theme-' + index; %> <div class="accordion-item border mb-3 shadow-sm overflow-hidden"><h2 class="accordion-header"><button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#<%= themeId %>"><%= set.theme_name %></button></h2><div id="<%= themeId %>" class="accordion-collapse collapse show"><div class="accordion-body p-3"><div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3"> <% } else if (index === 0 && query.sort) { %> <div class="border rounded p-3 mb-3 bg-body"><div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3"> <% } %>
                <div class="col"><div class="card h-100 set-card <%= set.user_status === 'OWNED' ? 'is-owned' : (set.user_status === 'WANTED' ? 'is-wanted' : '') %>" id="card-<%= set.set_num %>"><img src="<%= set.img_url || 'https://via.placeholder.com/150' %>" class="card-img-top" loading="lazy"><% if (set.user_status === 'OWNED') { %><span class="badge bg-success badge-owned">TENHO</span><% } %><% if (set.user_status === 'WANTED') { %><span class="badge bg-danger badge-owned">QUERO</span><% } %><div class="card-body p-2 d-flex flex-column text-center"><h6 class="card-title text-truncate small mb-1"><%= set.name %></h6><div class="small text-muted mb-2"><span class="fw-bold text-primary">#<%= set.set_num %></span> • <%= set.year %></div><div class="mt-auto card-actions d-flex justify-content-center gap-2"><a href="/set/<%= set.set_num %>" class="btn btn-outline-secondary"><i class="bi bi-eye"></i></a><% if (user) { %><button class="btn <%= set.user_status === 'WANTED' ? 'btn-danger' : 'btn-outline-danger' %>" onclick="toggleStatus('<%= set.set_num %>', 'WANTED')"><i class="bi <%= set.user_status === 'WANTED' ? 'bi-heart-fill' : 'bi-heart' %>"></i></button><button class="btn <%= set.user_status === 'OWNED' ? 'btn-success' : 'btn-outline-success' %>" onclick="toggleStatus('<%= set.set_num %>', 'OWNED')"><i class="bi <%= set.user_status === 'OWNED' ? 'bi-check-lg' : 'bi-plus-lg' %>"></i></button><% } %></div></div></div></div>
            <% }); if (sets.length > 0) { %> </div></div> <% if(!query.sort) { %> </div></div> <% } else { %> </div> <% } } %>
            </div>
            <% if (pagination.totalPages > 1) { %> <nav class="mt-4 pb-5 d-flex justify-content-center"><ul class="pagination shadow-sm"><li class="page-item <%= pagination.page == 1 ? 'disabled' : '' %>"><button class="page-link" onclick="changePage(<%= pagination.page - 1 %>)">&laquo;</button></li><li class="page-item d-flex align-items-center border-top border-bottom bg-body px-2"><select class="form-select form-select-sm pagination-select" onchange="changePage(this.value)"><% for(let i = 1; i <= pagination.totalPages; i++) { %><option value="<%= i %>" <%= pagination.page == i ? 'selected' : '' %>><%= i %></option><% } %></select></li><li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>"><button class="page-link" onclick="changePage(<%= pagination.page + 1 %>)">&raquo;</button></li></ul></nav> <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let html5QrCode; let currentSetNum = null;
    const scanModal = document.getElementById('scanModal');
    scanModal.addEventListener('shown.bs.modal', startScanner);
    scanModal.addEventListener('hidden.bs.modal', stopScanner);

    async function startScanner() {
        document.getElementById('reader').style.display = 'block'; document.getElementById('scannerControls').style.display = 'block'; document.getElementById('scanResult').style.display = 'none';
        try {
            const cameras = await Html5Qrcode.getCameras(); const camSelect = document.getElementById('cameraSelection'); camSelect.innerHTML = '';
            if (cameras && cameras.length) {
                cameras.forEach(c => { const opt = document.createElement('option'); opt.value = c.id; opt.text = c.label; camSelect.appendChild(opt); });
                let selected = cameras[0].id;
                const backCam = cameras.find(c => c.label.toLowerCase().includes('back') || c.label.toLowerCase().includes('environment'));
                if(backCam) { selected = backCam.id; camSelect.value = selected; }
                initReader(selected);
                camSelect.onchange = () => stopScanner().then(() => initReader(camSelect.value));
            } else alert('Sem câmaras.');
        } catch (e) { alert('Erro câmara.'); }
    }

    function initReader(id) {
        html5QrCode = new Html5Qrcode("reader");
        html5QrCode.start(id, { fps: 10, qrbox: { width: 250, height: 250 } }, onScanSuccess, () => {})
        .then(() => setTimeout(checkZoomCapability, 500));
    }

    function checkZoomCapability() {
        try {
            const track = html5QrCode.getRunningTrackCameraCapabilities();
            const slider = document.getElementById('zoomSlider');
            if (track && track.zoomFeature() && track.zoomFeature().isSupported()) {
                const z = track.zoomFeature(); document.getElementById('zoomContainer').classList.remove('d-none');
                slider.min = z.min(); slider.max = z.max(); slider.step = z.step(); slider.value = z.value();
                slider.oninput = function() { html5QrCode.applyVideoConstraints({ zoom: parseFloat(this.value) }); };
            } else document.getElementById('zoomContainer').classList.add('d-none');
        } catch(e){}
    }

    async function onScanSuccess(txt) {
        html5QrCode.pause();
        try {
            const res = await fetch(`/api/scan?code=${txt}`); const data = await res.json();
            if (data.found) showResult(data.set); else { alert('Não encontrado.'); html5QrCode.resume(); }
        } catch (e) { alert('Erro.'); html5QrCode.resume(); }
    }

    function showResult(set) {
        currentSetNum = set.set_num;
        document.getElementById('reader').style.display = 'none'; document.getElementById('scannerControls').style.display = 'none'; document.getElementById('scanResult').style.display = 'block';
        document.getElementById('resImg').src = set.img_url; document.getElementById('resName').innerText = set.name; document.getElementById('resNum').innerText = '#' + set.set_num;
        const st = document.getElementById('resStatus');
        if (set.user_status === 'OWNED') st.innerHTML = '<span class="text-success fw-bold">Já tens!</span>';
        else if (set.user_status === 'WANTED') st.innerHTML = '<span class="text-danger fw-bold">Na Wishlist.</span>';
        else st.innerHTML = '<span class="text-muted">Não tens.</span>';
    }

    async function performAction(s) { if(currentSetNum) { await toggleStatus(currentSetNum, s); stopScanner(); bootstrap.Modal.getInstance(scanModal).hide(); window.location.reload(); } }
    function resetScanner() { document.getElementById('scanResult').style.display = 'none'; document.getElementById('reader').style.display = 'block'; document.getElementById('scannerControls').style.display = 'block'; html5QrCode.resume(); }
    function stopScanner() { if (html5QrCode && html5QrCode.isScanning) html5QrCode.stop().then(()=>html5QrCode.clear()); }
    
    // Funções Antigas
    document.getElementById('themeSearchInput').addEventListener('keyup', (e) => { const term = e.target.value.toLowerCase(); document.querySelectorAll('.theme-item').forEach(item => { item.style.display = item.textContent.toLowerCase().includes(term) ? '' : 'none'; }); });
    function changeLimit(val) { document.getElementById('limitInput').value = val; savePref('items_per_page', val); submitPage(1); }
    function changeSort(val) { document.getElementById('sortInput').value = val; submitPage(1); }
    function changePage(p) { if(p>0) submitPage(p); }
    function submitPage(p) { document.querySelector('input[name="page"]').value = p; document.getElementById('filterForm').submit(); }
    document.getElementById('darkModeSwitch')?.addEventListener('change', (e) => { document.documentElement.setAttribute('data-bs-theme', e.target.checked ? 'dark' : 'light'); savePref('dark_mode', e.target.checked); });
    async function savePref(k, v) { try{ fetch('/api/preferences', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({[k]:v})}); }catch(e){} }
    async function toggleStatus(setNum, targetStatus) {
        const card = document.getElementById('card-' + setNum);
        const currentStatus = card && card.classList.contains('is-owned') ? 'OWNED' : (card && card.classList.contains('is-wanted') ? 'WANTED' : null);
        let newStatus = targetStatus; if (currentStatus === targetStatus) newStatus = 'REMOVE';
        try { const res = await fetch('/api/toggle', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({set_num: setNum, status: newStatus})}); if (res.ok) window.location.reload(); } catch(e) { alert('Erro'); }
    }
</script>
</body>
</html>
