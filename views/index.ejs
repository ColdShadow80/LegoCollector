<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= (user && user.dark_mode) ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LegoTracker V3</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { transition: background-color 0.3s, color 0.3s; }
        .set-card img { height: 160px; object-fit: contain; padding: 5px; transition: transform 0.2s; }
        .set-card:hover img { transform: scale(1.05); }
        [data-bs-theme="dark"] .card { background-color: #2b3035; border-color: #495057; }
        [data-bs-theme="dark"] .is-owned { background-color: #1a4d2e !important; border-color: #2ea043; }
        [data-bs-theme="light"] .is-owned { border: 2px solid #198754; background-color: #f0fff4; }
        .badge-owned { position: absolute; top: 5px; right: 5px; font-size: 0.7em; }
        .sidebar-scroll { max-height: 60vh; overflow-y: auto; }
        .pagination-select { border: none; background-color: transparent; font-weight: bold; text-align: center; cursor: pointer; }
        [data-bs-theme="dark"] .pagination-select { color: white; background-color: #212529; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg border-bottom mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="/">🧱 LegoTracker</a>
        <div class="d-flex align-items-center gap-3">
            <% if (user) { %>
                <div class="form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" id="darkModeSwitch" <%= user.dark_mode ? 'checked' : '' %>>
                    <label class="form-check-label"><i class="bi bi-moon-stars"></i></label>
                </div>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">👤 <%= user.name %></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/">Minha Coleção</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/logout">Sair</a></li>
                    </ul>
                </div>
            <% } else { %>
                <a href="/login" class="btn btn-primary btn-sm rounded-pill px-3">Entrar</a>
            <% } %>
        </div>
    </div>
</nav>

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-md-3 col-lg-2 mb-4">
            <form action="/" method="GET" id="filterForm">
                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary btn-sm">Aplicar Filtros</button>
                    <a href="/" class="btn btn-outline-secondary btn-sm">Limpar</a>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Pesquisa</label>
                    <input type="text" name="search" class="form-control form-control-sm" value="<%= query.search || '' %>" placeholder="Nome ou Nº Set...">
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Ano</label>
                    <select name="year" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        <% allYears.forEach(y => { %>
                            <option value="<%= y.year %>" <%= query.year == y.year ? 'selected' : '' %>><%= y.year %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Temas</label>
                    <input type="text" id="themeSearchInput" class="form-control form-control-sm mb-2" placeholder="Filtrar..." autocomplete="off">
                    <div class="sidebar-scroll border rounded p-2 bg-body-tertiary" id="themeListContainer">
                        <% allThemes.forEach(t => { %>
                            <div class="form-check mb-1 theme-item">
                                <input class="form-check-input" type="checkbox" name="themes" value="<%= t.name %>" id="t-<%= t.name %>"
                                <% if (query.themes && (query.themes === t.name || (Array.isArray(query.themes) && query.themes.includes(t.name)))) { %> checked <% } %>>
                                <label class="form-check-label small lh-sm" for="t-<%= t.name %>" style="cursor: pointer;">
                                    <span class="d-block text-truncate label-text" style="max-width: 180px;" title="<%= t.name %>"><%= t.name %></span>
                                    <span class="text-muted" style="font-size: 0.75em;">
                                        <% if (t.min_year) { %>(<%= t.min_year %><%= t.min_year !== t.max_year ? ' - ' + t.max_year : '' %>)<% } %>
                                    </span>
                                </label>
                            </div>
                        <% }) %>
                        <div id="noThemesMsg" class="text-center text-muted small mt-2" style="display:none;">Nada encontrado.</div>
                    </div>
                </div>
                <input type="hidden" name="limit" id="limitInput" value="<%= pagination.limit %>">
            </form>
        </div>

        <div class="col-md-9 col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                <span class="text-muted small"><%= pagination.totalItems %> sets encontrados</span>
                <div class="d-flex align-items-center gap-2">
                    <label class="small">Mostrar:</label>
                    <select class="form-select form-select-sm" style="width: 80px;" onchange="changeLimit(this.value)">
                        <option value="25" <%= pagination.limit == 25 ? 'selected' : '' %>>25</option>
                        <option value="50" <%= pagination.limit == 50 ? 'selected' : '' %>>50</option>
                        <option value="100" <%= pagination.limit == 100 ? 'selected' : '' %>>100</option>
                        <option value="all" <%= pagination.limit > 1000 ? 'selected' : '' %>>Tds</option>
                    </select>
                </div>
            </div>

            <% let lastTheme = null; 
               if (sets.length === 0) { %><div class="text-center py-5 text-muted"><h3>👻</h3><p>Nada encontrado.</p></div><% } %>

            <div class="accordion" id="accordionThemes">
            <% sets.forEach((set, index) => { 
                if (set.theme_name !== lastTheme) { 
                    if (lastTheme !== null) { %> </div></div></div> <% } 
                    lastTheme = set.theme_name; 
                    let themeId = 'theme-' + index; 
                %>
                <div class="accordion-item border mb-3 shadow-sm overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#<%= themeId %>">
                            <%= set.theme_name %>
                        </button>
                    </h2>
                    <div id="<%= themeId %>" class="accordion-collapse collapse show">
                        <div class="accordion-body p-3">
                            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3">
                <% } %>
                <div class="col">
                    <div class="card h-100 set-card <%= set.is_owned ? 'is-owned' : '' %>" id="card-<%= set.set_num %>">
                        <img src="<%= set.img_url || 'https://via.placeholder.com/150' %>" class="card-img-top" loading="lazy">
                        <% if (set.is_owned) { %><span class="badge bg-success badge-owned">TENHO</span><% } %>
                        <div class="card-body p-2 d-flex flex-column text-center">
                            <h6 class="card-title text-truncate small mb-1" title="<%= set.name %>"><%= set.name %></h6>
                            
                            <div class="small text-muted mb-2" style="font-size: 0.75rem;">
                                <span class="fw-bold text-primary">#<%= set.set_num %></span> • <%= set.year %> • <%= set.num_parts %> pçs
                            </div>

                            <div class="mt-auto">
                                <% if (user) { %>
                                    <button class="btn btn-sm w-100 py-0 small <%= set.is_owned ? 'btn-outline-danger' : 'btn-outline-success' %>" 
                                            onclick="toggleSet('<%= set.set_num %>', this)">
                                        <%= set.is_owned ? '-' : '+' %>
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
            <% if (sets.length > 0) { %> </div></div></div></div> <% } %>
            </div>

            <% if (pagination.totalPages > 1) { %>
                <nav class="mt-4 pb-5 d-flex justify-content-center">
                    <ul class="pagination shadow-sm">
                        <li class="page-item <%= pagination.page == 1 ? 'disabled' : '' %>"><button class="page-link" onclick="changePage(<%= pagination.page - 1 %>)">&laquo;</button></li>
                        <li class="page-item d-flex align-items-center border-top border-bottom bg-body px-2">
                            <select class="form-select form-select-sm pagination-select" style="width: auto;" onchange="changePage(this.value)">
                                <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                                    <option value="<%= i %>" <%= pagination.page == i ? 'selected' : '' %>><%= i %></option>
                                <% } %>
                            </select>
                            <span class="small text-muted ms-2">de <%= pagination.totalPages %></span>
                        </li>
                        <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>"><button class="page-link" onclick="changePage(<%= pagination.page + 1 %>)">&raquo;</button></li>
                    </ul>
                </nav>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const searchInput = document.getElementById('themeSearchInput');
        const listContainer = document.getElementById('themeListContainer');
        const noMsg = document.getElementById('noThemesMsg');
        if (searchInput && listContainer) {
            searchInput.addEventListener('keyup', function(e) {
                const term = e.target.value.toLowerCase();
                const items = listContainer.getElementsByClassName('theme-item');
                let hasVisible = false;
                Array.from(items).forEach(item => {
                    const labelSpan = item.querySelector('.label-text');
                    const text = labelSpan ? labelSpan.textContent : item.textContent;
                    if (text.toLowerCase().indexOf(term) > -1) { item.style.display = ""; hasVisible = true; } else { item.style.display = "none"; }
                });
                if (noMsg) noMsg.style.display = hasVisible ? 'none' : 'block';
            });
        }
    });
    function changeLimit(val) { document.getElementById('limitInput').value = val; <% if (user) { %> savePreference('items_per_page', val); <% } %> submitFormWithPage(1); }
    function changePage(p) { if(p>0) submitFormWithPage(p); }
    function submitFormWithPage(p) {
        const f = document.getElementById('filterForm');
        let i = f.querySelector('input[name="page"]');
        if(!i) { i = document.createElement('input'); i.type = 'hidden'; i.name = 'page'; f.appendChild(i); }
        i.value = p; f.submit();
    }
    const dm = document.getElementById('darkModeSwitch');
    if(dm) dm.addEventListener('change', (e) => {
        document.documentElement.setAttribute('data-bs-theme', e.target.checked ? 'dark' : 'light');
        savePreference('dark_mode', e.target.checked);
    });
    async function savePreference(k, v) { try{ fetch('/api/preferences', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({[k]:v})}); }catch(e){} }
    async function toggleSet(id, btn) {
        const isRem = btn.classList.contains('btn-outline-danger');
        btn.disabled = true;
        try {
            const res = await fetch('/api/toggle', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({set_num:id,active:!isRem})});
            if(res.ok) {
                const card = document.getElementById('card-'+id);
                if(!isRem) { btn.className='btn btn-sm w-100 py-0 small btn-outline-danger'; btn.innerHTML='-'; card.classList.add('is-owned'); 
                             if(!card.querySelector('.badge-owned')) card.querySelector('.card-img-top').after(Object.assign(document.createElement('span'),{className:'badge bg-success badge-owned',innerText:'TENHO'})); }
                else { btn.className='btn btn-sm w-100 py-0 small btn-outline-success'; btn.innerHTML='+'; card.classList.remove('is-owned'); 
                       const b = card.querySelector('.badge-owned'); if(b) b.remove(); }
            }
        } catch(e){} finally { btn.disabled=false; }
    }
</script>
</body>
</html>
