<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= (user && user.dark_mode) ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LegoTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

    <style>
        /* Transição suave entre temas */
        body { transition: background-color 0.3s, color 0.3s; }
        
        /* Estilo dos Cards */
        .set-card img { 
            height: 180px; 
            object-fit: contain; 
            padding: 10px; 
            transition: transform 0.2s; 
        }
        .set-card:hover img { transform: scale(1.05); }
        
        /* Ajustes específicos para Dark Mode */
        [data-bs-theme="dark"] .card { 
            background-color: #2b3035; 
            border-color: #495057; 
        }
        
        /* Destaque para Sets "OWNED" (Possuídos) */
        .card.is-owned { 
            border: 2px solid #198754 !important; 
        }
        [data-bs-theme="dark"] .card.is-owned { 
            background-color: #1a2e22; 
        }
        [data-bs-theme="light"] .card.is-owned { 
            background-color: #f0fff4; 
        }

        /* Destaque para Sets "WANTED" (Desejados) */
        .card.is-wanted { 
            border: 2px dashed #ffc107 !important; 
        }
    </style>
</head>
<body class="bg-body-tertiary">

    <nav class="navbar navbar-expand-lg border-bottom mb-4 bg-body-tertiary sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-bricks text-primary"></i> LegoTracker
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">🏠 Coleção</a>
                    </li>

                    <% if (user && user.id === 1) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" role="button" data-bs-toggle="dropdown">
                                ⚙️ Admin
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people"></i> Gerir Utilizadores</a></li>
                                <li><a class="dropdown-item" href="/admin/sets"><i class="bi bi-box-seam"></i> Gerir Sets</a></li>
                                <li><a class="dropdown-item" href="/admin/themes"><i class="bi bi-palette"></i> Gerir Temas</a></li>
                            </ul>
                        </li>
                    <% } %>
                </ul>

                <ul class="navbar-nav align-items-center gap-3">
                    <% if (user) { %>
                        <li class="nav-item">
                            <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#scannerModal">
                                <i class="bi bi-upc-scan"></i> Scan
                            </button>
                        </li>

                        <li class="nav-item">
                            <div class="form-check form-switch pt-2" title="Alterar Tema">
                                <input class="form-check-input" type="checkbox" id="darkModeSwitch" 
                                    <%= (user.dark_mode) ? 'checked' : '' %>>
                                <label class="form-check-label" for="darkModeSwitch">
                                    <%= (user.dark_mode) ? '🌙' : '☀️' %>
                                </label>
                            </div>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                👤 <%= user.name %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/logout">Sair</a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="btn btn-primary" href="/login">Entrar</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        
        <div class="card p-3 mb-4 shadow-sm">
            <form action="/" method="GET" id="filterForm" class="row g-3 align-items-end">
                <input type="hidden" name="page" value="1">
                <input type="hidden" name="sort" id="sortInput" value="<%= filters.sort %>">
                
                <div class="col-md-4">
                    <label class="form-label small text-muted">Pesquisar</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" name="q" value="<%= filters.search %>" placeholder="Nome ou Número do Set...">
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted">Tema</label>
                    <select class="form-select" name="theme">
                        <option value="">Todos os Temas</option>
                        <% themes.forEach(t => { %>
                            <option value="<%= t.id %>" <%= filters.theme == t.id ? 'selected' : '' %>>
                                <%= t.name %> (<%= t.count %>)
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted">Ano</label>
                    <input type="number" class="form-control" name="year" value="<%= filters.year %>" placeholder="Ex: 2024">
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                </div>
                
                <div class="col-md-1">
                    <a href="/" class="btn btn-outline-secondary w-100" title="Limpar Filtros">❌</a>
                </div>
            </form>

            <div class="mt-3 d-flex gap-2 text-small">
                <span class="text-muted align-self-center">Ordenar por:</span>
                <button type="button" class="btn btn-sm <%= filters.sort === 'newest' ? 'btn-secondary' : 'btn-outline-secondary' %>" onclick="changeSort('newest')">Mais Recentes</button>
                <button type="button" class="btn btn-sm <%= filters.sort === 'pieces' ? 'btn-secondary' : 'btn-outline-secondary' %>" onclick="changeSort('pieces')">Peças</button>
                <button type="button" class="btn btn-sm <%= filters.sort === 'price' ? 'btn-secondary' : 'btn-outline-secondary' %>" onclick="changeSort('price')">Preço</button>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            <% sets.forEach(set => { 
                let statusClass = '';
                if(set.owned) statusClass = 'is-owned';
                else if(set.wanted) statusClass = 'is-wanted';
            %>
            <div class="col">
                <div class="card h-100 shadow-sm set-card <%= statusClass %>" id="card-<%= set.set_num %>">
                    <div class="text-center bg-light rounded-top position-relative">
                        <img src="<%= set.img_url || '/placeholder.png' %>" alt="<%= set.name %>" loading="lazy">
                        <span class="position-absolute top-0 end-0 badge bg-dark m-2"><%= set.year %></span>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title text-truncate" title="<%= set.name %>"><%= set.name %></h6>
                        <p class="card-text small text-muted mb-1">
                            #<%= set.set_num %> • <%= set.num_parts %> peças
                        </p>
                        <p class="card-text fw-bold text-primary mb-3">
                            <%= set.price_eur ? '€' + set.price_eur.toFixed(2) : 'N/A' %>
                        </p>

                        <div class="mt-auto d-flex gap-2">
                            <% if (user) { %>
                                <button class="btn btn-sm w-50 <%= set.owned ? 'btn-success' : 'btn-outline-success' %>" 
                                    onclick="toggleStatus('<%= set.set_num %>', 'OWNED')">
                                    <i class="bi bi-check-lg"></i> Tenho
                                </button>
                                <button class="btn btn-sm w-50 <%= set.wanted ? 'btn-warning' : 'btn-outline-warning' %>" 
                                    onclick="toggleStatus('<%= set.set_num %>', 'WANTED')">
                                    <i class="bi bi-heart"></i> Quero
                                </button>
                            <% } else { %>
                                <a href="/login" class="btn btn-sm btn-outline-secondary w-100">Login p/ gerir</a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>

        <% if (sets.length === 0) { %>
            <div class="text-center py-5">
                <h3 class="text-muted">Nenhum set encontrado 😢</h3>
                <p>Tente ajustar os filtros de pesquisa.</p>
            </div>
        <% } %>

        <% if (pagination.totalPages > 1) { %>
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item <%= pagination.page == 1 ? 'disabled' : '' %>">
                        <button class="page-link" onclick="changePage(<%= pagination.page - 1 %>)">Anterior</button>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Página <%= pagination.page %> de <%= pagination.totalPages %></span>
                    </li>
                    <li class="page-item <%= pagination.page == pagination.totalPages ? 'disabled' : '' %>">
                        <button class="page-link" onclick="changePage(<%= pagination.page + 1 %>)">Próxima</button>
                    </li>
                </ul>
            </nav>
        <% } %>

    </div>

    <div class="modal fade" id="scannerModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Scanner de Código de Barras</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <div id="reader" style="width: 100%;"></div>
                    <p class="mt-2 text-muted small">Aponte a câmera para o código de barras da caixa.</p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // 1. MANIPULAÇÃO DO DARK MODE
        const darkModeSwitch = document.getElementById('darkModeSwitch');
        if (darkModeSwitch) {
            darkModeSwitch.addEventListener('change', (e) => {
                const isDark = e.target.checked;
                // Muda atributo no HTML imediatamente
                document.documentElement.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
                // Altera o emoji no label
                e.target.nextElementSibling.innerText = isDark ? '🌙' : '☀️';
                // Salva na BD
                savePref('dark_mode', isDark);
            });
        }

        async function savePref(key, value) {
            try {
                await fetch('/api/preferences', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ [key]: value })
                });
            } catch (e) { console.error("Erro ao salvar preferência", e); }
        }

        // 2. FUNÇÕES DE FILTRO E PAGINAÇÃO
        function changeSort(val) {
            document.getElementById('sortInput').value = val;
            document.getElementById('filterForm').submit();
        }

        function changePage(p) {
            if (p > 0) {
                document.querySelector('input[name="page"]').value = p;
                document.getElementById('filterForm').submit();
            }
        }

        // 3. ALTERAR STATUS (OWNED/WANTED)
        async function toggleStatus(setNum, targetStatus) {
            const card = document.getElementById('card-' + setNum);
            
            // Determina estado atual visualmente
            let currentStatus = null;
            if (card.classList.contains('is-owned')) currentStatus = 'OWNED';
            else if (card.classList.contains('is-wanted')) currentStatus = 'WANTED';

            // Lógica: Se clicar no mesmo que já tem, remove (Toggle off)
            let newStatus = targetStatus;
            if (currentStatus === targetStatus) newStatus = 'REMOVE';

            try {
                const res = await fetch('/api/toggle', { // Assumindo rota existente no server.js
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ set_num: setNum, status: newStatus })
                });
                
                if (res.ok) {
                    // Atualiza UI sem recarregar
                    card.classList.remove('is-owned', 'is-wanted'); // Limpa tudo
                    
                    const btnOwn = card.querySelector('.btn-success, .btn-outline-success');
                    const btnWant = card.querySelector('.btn-warning, .btn-outline-warning');

                    // Reset Botões
                    btnOwn.className = 'btn btn-sm w-50 btn-outline-success';
                    btnWant.className = 'btn btn-sm w-50 btn-outline-warning';

                    if (newStatus === 'OWNED') {
                        card.classList.add('is-owned');
                        btnOwn.className = 'btn btn-sm w-50 btn-success';
                    } else if (newStatus === 'WANTED') {
                        card.classList.add('is-wanted');
                        btnWant.className = 'btn btn-sm w-50 btn-warning';
                    }
                }
            } catch (e) {
                alert('Erro ao atualizar status.');
            }
        }

        // 4. SCANNER (Opcional - só ativa se o modal for aberto)
        const scannerModal = document.getElementById('scannerModal');
        let html5QrcodeScanner;

        scannerModal.addEventListener('shown.bs.modal', () => {
            html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: 250 });
            html5QrcodeScanner.render(onScanSuccess);
        });

        scannerModal.addEventListener('hidden.bs.modal', () => {
            if (html5QrcodeScanner) html5QrcodeScanner.clear();
        });

        function onScanSuccess(decodedText, decodedResult) {
            // Redireciona para pesquisa com o código lido
            window.location.href = `/?q=${decodedText}`;
        }
    </script>
</body>
</html>
