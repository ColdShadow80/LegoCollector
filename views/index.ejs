<!DOCTYPE html>
<html lang="pt" data-bs-theme="<%= (user && user.dark_mode) ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LegoTracker V11</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <style>
        body { transition: background-color 0.3s; }
        .set-card img { height: 160px; object-fit: contain; padding: 10px; }
        .is-owned { border: 2px solid #198754 !important; background-color: rgba(25, 135, 84, 0.05); }
        .is-wanted { border: 2px solid #dc3545 !important; background-color: rgba(220, 53, 69, 0.05); }
        .sidebar-scroll { max-height: 60vh; overflow-y: auto; }
        #reader { width: 100%; border-radius: 12px; overflow: hidden; background: #000; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg border-bottom mb-4 shadow-sm sticky-top bg-body">
    <div class="container-fluid px-3 px-lg-4">
        <a class="navbar-brand fw-bold text-primary" href="/">🧱 LegoTracker</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <% if (user) { %>
                    <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/?status=owned"><i class="bi bi-box-seam"></i> Coleção</a></li>
                    <li class="nav-item"><a class="nav-link" href="/?status=wanted"><i class="bi bi-heart"></i> Wishlist</a></li>
                <% } %>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <% if (user) { %>
                    <button class="btn btn-warning fw-bold rounded-pill px-3 btn-sm" data-bs-toggle="modal" data-bs-target="#scanModal"><i class="bi bi-upc-scan"></i> Scan</button>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary rounded-pill dropdown-toggle px-3 btn-sm" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> <%= user.name.split(' ')[0] %>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li><a class="dropdown-item" href="/import"><i class="bi bi-arrow-down-up"></i> Import/Export</a></li>
                            <li><a class="dropdown-item" href="/manual"><i class="bi bi-book"></i> Manual</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <% if (user.id === 1) { %>
                                <li><h6 class="dropdown-header text-danger">Admin</h6></li>
                                <li><a class="dropdown-item" href="/admin/sets">Gerir Sets</a></li>
                                <li><a class="dropdown-item" href="/admin/themes">Gerir Temas</a></li>
                                <li><a class="dropdown-item" href="/admin/users">Gerir Users</a></li>
                                <li><hr class="dropdown-divider"></li>
                            <% } %>
                            <li class="px-3 py-1">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="darkModeSwitch" <%= user.dark_mode ? 'checked' : '' %>>
                                    <label class="form-check-label small" for="darkModeSwitch">Dark Mode</label>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/logout">Sair</a></li>
                        </ul>
                    </div>
                <% } else { %> <a href="/login" class="btn btn-primary rounded-pill px-4">Entrar</a> <% } %>
            </div>
        </div>
    </div>
</nav>

<div class="modal fade" id="scanModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fs-6"><i class="bi bi-qr-code-scan"></i> Scanner AI</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="stopScanner()"></button>
            </div>
            <div class="modal-body p-0 bg-black position-relative">
                <div id="reader"></div>
                <div id="feedbackArea" class="text-white text-center p-2 small border-top border-secondary"><span id="debugScan">Iniciando...</span></div>
                <div id="scanResult" class="p-4 bg-body text-center" style="display:none;">
                    <img id="resImg" src="" class="rounded mb-3" style="height: 150px; object-fit: contain;">
                    <h5 id="resName" class="fw-bold mb-1"></h5>
                    <div id="resStatus" class="mb-3"></div>
                    <div class="d-flex gap-2"><button class="btn btn-outline-danger flex-fill" onclick="performAction('WANTED')">Quero</button><button class="btn btn-success flex-fill" onclick="performAction('OWNED')">Tenho</button></div>
                    <button class="btn btn-link btn-sm mt-3" onclick="resetScanner()">Ler outro</button>
                </div>
            </div>
            <div class="modal-footer bg-dark border-secondary p-2 d-block">
                <div class="input-group input-group-sm mb-2">
                    <label class="input-group-text bg-secondary text-white border-0"><i class="bi bi-camera-video"></i></label>
                    <select class="form-select bg-black text-white border-secondary" id="cameraSelection"></select>
                </div>
                <div class="input-group input-group-sm">
                    <input type="number" id="manualSetNum" class="form-control bg-black text-white border-secondary" placeholder="Nº do Set manual...">
                    <button class="btn btn-primary" onclick="manualSearch()">Corrigir</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4">
    <div class="row">
        <aside class="col-md-3 col-lg-2">
            <form action="/" method="GET" id="filterForm">
                <div class="mb-3"><label class="small fw-bold">Pesquisa</label><input type="text" name="search" class="form-control form-control-sm" value="<%= query.search || '' %>"></div>
                <div class="mb-3"><label class="small fw-bold">Ano</label><select name="year" class="form-select form-select-sm"><option value="">Todos</option><% allYears.forEach(y => { %><option value="<%= y.year %>" <%= query.year == y.year ? 'selected' : '' %>><%= y.year %></option><% }) %></select></div>
                <div class="sidebar-scroll border rounded p-2 bg-body-tertiary">
                    <% allThemes.forEach(t => { %>
                        <div class="form-check small"><input class="form-check-input" type="checkbox" name="themes" value="<%= t.name %>" <%= (query.themes && (query.themes === t.name || query.themes.includes(t.name))) ? 'checked' : '' %>><label class="form-check-label"><%= t.name %></label></div>
                    <% }) %>
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100 mt-3">Filtrar</button>
                <input type="hidden" name="sort" id="sortInput" value="<%= query.sort || '' %>">
                <input type="hidden" name="status" value="<%= query.status || '' %>">
            </form>
        </aside>

        <main class="col-md-9 col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Resultados (<%= pagination.totalItems %>)</h5>
                <select class="form-select form-select-sm w-auto" onchange="document.getElementById('sortInput').value=this.value; document.getElementById('filterForm').submit()">
                    <option value="" <%= !query.sort ? 'selected' : '' %>>Nome (A-Z)</option>
                    <option value="year_desc" <%= query.sort == 'year_desc' ? 'selected' : '' %>>Ano (Novo)</option>
                    <option value="parts_desc" <%= query.sort == 'parts_desc' ? 'selected' : '' %>>Mais Peças</option>
                </select>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
                <% sets.forEach(set => { %>
                <div class="col">
                    <div class="card h-100 set-card shadow-sm <%= set.user_status === 'OWNED' ? 'is-owned' : (set.user_status === 'WANTED' ? 'is-wanted' : '') %>">
                        <a href="/set/<%= set.set_num %>"><img src="<%= set.img_url %>" class="card-img-top"></a>
                        <div class="card-body p-2 text-center">
                            <h6 class="card-title text-truncate small fw-bold mb-1"><%= set.name %></h6>
                            <small class="text-muted d-block mb-2">#<%= set.set_num %> · <%= set.year %></small>
                            <% if (user) { %>
                                <div class="btn-group w-100">
                                    <button class="btn btn-sm btn-outline-danger" onclick="toggleStatus('<%= set.set_num %>', 'WANTED')"><i class="bi bi-heart<%= set.user_status === 'WANTED' ? '-fill' : '' %>"></i></button>
                                    <button class="btn btn-sm btn-outline-success" onclick="toggleStatus('<%= set.set_num %>', 'OWNED')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </main>
    </div>
</div>

<script>
    // DARK MODE
    document.getElementById('darkModeSwitch').addEventListener('change', function() {
        document.documentElement.setAttribute('data-bs-theme', this.checked ? 'dark' : 'light');
        fetch('/api/preferences', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ dark_mode: this.checked })});
    });

    async function toggleStatus(num, stat) {
        await fetch('/api/toggle', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ set_num: num, status: stat })});
        window.location.reload();
    }

    // SCANNER LÓGICA
    let html5QrCode; let lastFailedBarcode = null;
    const scanModal = document.getElementById('scanModal');
    scanModal.addEventListener('shown.bs.modal', startScanner);

    async function startScanner() {
        const cameras = await Html5Qrcode.getCameras();
        const camSelect = document.getElementById('cameraSelection');
        camSelect.innerHTML = cameras.map(c => `<option value="${c.id}">${c.label}</option>`).join('');
        camSelect.onchange = async () => { if(html5QrCode) await html5QrCode.stop(); initReader(camSelect.value); };
        initReader(cameras[0].id);
    }

    function initReader(id) {
        html5QrCode = new Html5Qrcode("reader");
        html5QrCode.start(id, { fps: 10, qrbox: 250 }, async (txt) => {
            html5QrCode.pause();
            document.getElementById('debugScan').innerText = "Lido: " + txt;
            await searchSet(txt, false);
        });
    }

    async function searchSet(query, isManual) {
        const res = await fetch(`/api/scan?code=${query}`);
        const data = await res.json();
        if (data.found) {
            document.getElementById('scanResult').style.display = 'block';
            document.getElementById('reader').style.display = 'none';
            document.getElementById('resImg').src = data.set.img_url;
            document.getElementById('resName').innerText = data.set.name;
            window.currentSetNum = data.set.set_num;
            if(isManual && lastFailedBarcode) fetch('/api/scan/associate', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ barcode: lastFailedBarcode, set_num: data.set.set_num })});
        } else {
            lastFailedBarcode = query;
            alert("Não encontrado. Insira o nº manual.");
            if(html5QrCode) html5QrCode.resume();
        }
    }

    async function stopScanner() { if(html5QrCode) await html5QrCode.stop(); }
    function resetScanner() { document.getElementById('scanResult').style.display = 'none'; document.getElementById('reader').style.display = 'block'; if(html5QrCode) html5QrCode.resume(); }
    async function performAction(s) { if(window.currentSetNum) { await toggleStatus(window.currentSetNum, s); } }
</script>
</body>
</html>
