<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lego DB</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .card-img-top { height: 200px; object-fit: contain; padding: 10px; }
        .owned-badge { position: absolute; top: 10px; right: 10px; }
        .retired { color: red; font-weight: bold; font-size: 0.8em; }
    </style>
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">🧱 Meu Catálogo Lego</a>
    </div>
</nav>

<div class="container">
    <form class="row g-3 mb-4 bg-white p-3 rounded shadow-sm" action="/" method="GET">
        <div class="col-md-3">
            <input type="text" name="search" class="form-control" placeholder="Buscar Nome ou ID" value="<%= query.search || '' %>">
        </div>
        <div class="col-md-2">
            <select name="theme" class="form-select">
                <option value="">Todos os Temas</option>
                <% themes.forEach(t => { %>
                    <option value="<%= t.name %>" <%= query.theme === t.name ? 'selected' : '' %>><%= t.name %></option>
                <% }) %>
            </select>
        </div>
        <div class="col-md-2">
            <select name="year" class="form-select">
                <option value="">Todos os Anos</option>
                <% years.forEach(y => { %>
                    <option value="<%= y.year %>" <%= query.year == y.year ? 'selected' : '' %>><%= y.year %></option>
                <% }) %>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">Status</option>
                <option value="retired" <%= query.status === 'retired' ? 'selected' : '' %>>Descontinuados</option>
                <option value="owned" <%= query.status === 'owned' ? 'selected' : '' %>>Minha Coleção</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
        </div>
    </form>

    <div class="row row-cols-1 row-cols-md-4 g-4">
        <% sets.forEach(set => { %>
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="<%= set.img_url %>" class="card-img-top" alt="<%= set.name %>">
                    <% if(set.owned) { %>
                        <span class="badge bg-success owned-badge">Na Coleção</span>
                    <% } %>
                    <div class="card-body">
                        <h6 class="card-title text-truncate"><%= set.name %></h6>
                        <p class="card-text small text-muted">
                            <%= set.set_num %> | <%= set.year %> <br>
                            <%= set.theme_name %> <br>
                            Peças: <%= set.num_parts %>
                        </p>
                        <% if(set.eol_status === 'Retired') { %>
                            <p class="retired">DESCONTINUADO</p>
                        <% } %>
                        <div class="form-check form-switch">
                            <input class="form-check-input toggle-owned" type="checkbox" 
                                data-id="<%= set.set_num %>" <%= set.owned ? 'checked' : '' %>>
                            <label class="form-check-label small">Tenho este set</label>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<script>
    // Script para marcar "Tenho" sem recarregar a página
    document.querySelectorAll('.toggle-owned').forEach(toggle => {
        toggle.addEventListener('change', async (e) => {
            const setNum = e.target.dataset.id;
            const isOwned = e.target.checked;
            
            await fetch('/api/toggle-owned', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ set_num: setNum, owned: isOwned })
            });
            // Opcional: Adicionar reload ou manipular o DOM para mostrar badge
            location.reload(); 
        });
    });
</script>

</body>
</html>
